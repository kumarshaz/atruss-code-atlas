      "id": "release.yml",
      "path": ".github/workflows/release.yml",
      "name": "Release helm chart",
      "triggers": [
        "workflow_call"
      ],
      "jobs": {
        "release": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "id-token": "write"
          },
          "steps": [
            {
              "name": "Clone helm repo",
              "uses": "actions/checkout@0717577d45739eb3c851188b29f50ed6c0b2194e",
              "with": {
                "repository": "${{ env.REPO }}",
                "path": "./helm-charts",
                "token": "${{ secrets.github-token }}"
              }
            },
            {
              "name": "Clone helm repo (gh-pages)",
              "uses": "actions/checkout@0717577d45739eb3c851188b29f50ed6c0b2194e",
              "with": {
                "repository": "${{ env.REPO }}",
                "ref": "gh-pages",
                "path": "./gh-pages",
                "token": "${{ secrets.github-token }}"
              }
            },
            {
              "name": "Update chart and app versions",
              "shell": "bash",
              "id": "version",
              "run": "sed -i -r '/^appVersion:/ s/ .+/ ${{ inputs.tag }}/' ./helm-charts/${{ inputs.chartName }}/Chart.yaml\nsed -i -r '/^version:/ s/ .+/ ${{ inputs.chartVersion }}/' ./helm-charts/${{ inputs.chartName }}/Chart.yaml\n"
            },
            {
              "name": "Pull dependencies",
              "shell": "bash",
              "run": "helm dependency update ./helm-charts/${{ inputs.chartName }}"
            },
            {
              "name": "Generate helm package",
              "shell": "bash",
              "run": "helm package ./helm-charts/${{ inputs.chartName }} -d gh-pages/charts/"
            },
            {
              "name": "Re-generate helm index",
              "run": "helm repo index ./gh-pages/"
            },
            {
              "name": "Install ORAS",
              "uses": "oras-project/setup-oras@22ce207df3b08e061f537244349aac6ae1d214f6"
            },
            {
              "name": "OIDC token",
              "id": "docker_oidc",
              "uses": "docker/oidc-action@96ba694c64860c7209bcd1ede7d698c71564ef78",
              "with": {
                "connection-id": "${{ secrets.docker-oidc-id }}"
              }
            },
            {
              "name": "Docker OIDC login",
              "uses": "docker/login-action@dbcb813823bdd20940b903addbd779551569679f",
              "with": {
                "username": "rocketchat",
                "password": "${{ steps.docker_oidc.outputs.token }}"
              }
            },
            {
              "name": "Push chart to Docker Hub OCI",
              "shell": "bash",
              "run": "# Map chart names to OCI repository names\ncase \"${{ inputs.chartName }}\" in\n  rocketchat)      oci_repo=\"helm-rocketchat\" ;;\n  monitoring)      oci_repo=\"helm-monitoring\" ;;\n  rocketchat-voip) oci_repo=\"helm-voip\" ;;\n  rocketchat-livekit) oci_repo=\"helm-livekit\" ;;\n  *)               oci_repo=\"helm-${{ inputs.chartName }}\" ;;\nesac\n\n# Use ORAS to push with exact repository name (helm push appends chart name)\noras push docker.io/rocketchat/${oci_repo}:${{ inputs.chartVersion }} \\\n  ./gh-pages/charts/${{ inputs.chartName }}-${{ inputs.chartVersion }}.tgz:application/vnd.cncf.helm.chart.content.v1.tar+gzip\n"
            },
            {
              "name": "Push to master",
              "uses": "EndBug/add-and-commit@a94899bca583c204427a224a7af87c02f9b325d5",
              "with": {
                "add": "${{ inputs.chartName }}/Chart.yaml",
                "cwd": "helm-charts",
                "message": "Chore: bump Rocket.Chat and chart version to ${{ inputs.chartVersion }} with Rocket.Chat version ${{ inputs.tag }}",
                "push": true
              }
            },
            {
              "name": "Push to gh-pages",
              "uses": "EndBug/add-and-commit@a94899bca583c204427a224a7af87c02f9b325d5",
              "with": {
                "add": ".",
                "cwd": "gh-pages",
                "message": "Chore: bump ${{ inputs.chartName }} and chart version to ${{ inputs.chartVersion }} with AppVersion version ${{ inputs.tag }}",
                "push": true
              }
            },
            {
              "name": "Create a release with artifact",
              "uses": "softprops/action-gh-release@de2c0eb89ae2a093876385947365aca7b0e5f844",
              "with": {
                "files": "${{ format('./gh-pages/charts/${0}-{1}.tgz', inputs.chartName, inputs.chartVersion) }}",
                "prerelease": false,
                "repository": "${{ env.REPO }}",
                "token": "${{ secrets.github-token }}",
                "name": "${{ inputs.chartName }}-${{ inputs.chartVersion }}",
                "tag_name": "${{ inputs.chartName}}-${{ inputs.chartVersion }}",
                "body": "${{ format('https://github.com/RocketChat/Rocket.Chat/releases/{1}-{0}', inputs.chartName, inputs.tag) }}",
                "generate_release_notes": true,
                "draft": false
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "release",
          "name": "release",
          "runner": "ubuntu-latest",
          "steps_count": 13,
          "needs": [],
          "environment": null
        }
      ],
