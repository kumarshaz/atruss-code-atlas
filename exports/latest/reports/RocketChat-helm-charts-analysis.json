      "id": "main.yml",
      "path": ".github/workflows/main.yml",
      "name": "Test and/or release helm chart",
      "triggers": [
        "workflow_call"
      ],
      "jobs": {
        "set-versions": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "read"
          },
          "outputs": {
            "chart-version": "${{ steps.set-chart-version.outputs.chart-version }}",
            "app-version": "${{ inputs.tag }}",
            "run": "${{ steps.set-chart-version.outputs.run }}"
          },
          "steps": [
            {
              "uses": "actions/checkout@a37ce9120846195fa4ece8f58b268e6043cb2f26",
              "with": {
                "repository": "${{ env.HELM_REPO }}"
              }
            },
            {
              "uses": "debdutdeb/semis@main"
            },
            {
              "id": "set-chart-version",
              "shell": "bash",
              "run": "chart_version=\"${{ inputs.chartVersion}}\"\nif [[ -n \"$chart_version\" ]]; then\n  echo \"chart-version=$chart_version\"\n  echo \"chart-version=$chart_version\" >>$GITHUB_OUTPUT\n  echo \"run=true\" >> $GITHUB_OUTPUT\n  exit 0\nfi\n\nchart_version=\"$(awk '/^version:/ {print $2}' ${{ inputs.chartName}}/Chart.yaml)\"\n[[ -n \"$chart_version\" ]]\napp_version=\"$(awk '/^appVersion:/ {print $2}' ${{ inputs.chartName}}/Chart.yaml)\"\n[[ -n \"$app_version\" ]]\n\nnew_version=\"${{ inputs.tag }}\"\nnew_version=\"${new_version%-rc*}\"\n\nif ! semis gt \"$new_version\" \"$app_version\"; then\n  echo \"run=false\" >>$GITHUB_OUTPUT\n  exit 0\nfi\n\nnew_version=(${new_version//./ })\n\nold_version=(${app_version//./ })\n\nchart_version=(${chart_version//./ })\n\nchart_version_string=\n\nif [[ \"${new_version[0]}\" -gt \"${old_version[0]}\" ]]; then\n  # major bump\n  chart_version_string=\"$((chart_version[0] + 1)).0.0\"\nelif [[ \"${new_version[1]}\" -gt \"${old_version[1]}\" ]]; then\n  # minor bump\n  chart_version_string=\"${chart_version[0]}.$((chart_version[1] + 1)).0\"\nelif [[ \"${new_version[2]}\" -gt \"${old_version[2]}\" ]]; then\n  # patch bump\n  chart_version_string=\"${chart_version[0]}.${chart_version[1]}.$((chart_version[2] + 1))\"\nfi\n\necho \"chart-version=$chart_version_string\"\necho \"chart-version=$chart_version_string\" >>$GITHUB_OUTPUT\necho 'run=true' >> $GITHUB_OUTPUT\n"
            }
          ]
        },
        "can-chart-run": {
          "needs": [
            "set-versions"
          ],
          "if": "${{ needs.set-versions.outputs.run }} == 'true'",
          "permissions": {
            "contents": "read"
          },
          "uses": "./.github/workflows/test.yml",
          "with": {
            "tag": "${{ needs.set-versions.outputs.app-version }}",
            "chartVersion": "${{ needs.set-versions.outputs.chart-version }}",
            "chartName": "${{ inputs.chartName }}"
          }
        },
        "update-release": {
          "needs": [
            "can-chart-run",
            "set-versions"
          ],
          "if": "! contains(inputs.tag, 'rc')",
          "permissions": {
            "contents": "write",
            "id-token": "write"
          },
          "uses": "./.github/workflows/release.yml",
          "with": {
            "tag": "${{ inputs.tag }}",
            "chartVersion": "${{ needs.set-versions.outputs.chart-version}}",
            "chartName": "${{ inputs.chartName }}"
          },
          "secrets": {
            "github-token": "${{ secrets.github-token }}",
            "docker-oidc-id": "${{ secrets.docker-oidc-id }}"
          }
        }
      },
      "job_nodes": [
