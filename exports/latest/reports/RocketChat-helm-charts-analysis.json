    {
      "id": "test.yml",
      "path": ".github/workflows/test.yml",
      "name": "Test helm chart",
      "triggers": [
        "workflow_call",
        "workflow_dispatch",
        "push"
      ],
      "jobs": {
        "setup-docker": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Setup docker",
              "uses": "docker/setup-docker-action@e43656e248c0bd0647d3f5c195d116aacf6fcaf4"
            }
          ]
        },
        "setup-k3d": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "Rocketchat/k3d-with-registry@main"
            }
          ]
        },
        "detect-changes": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "read"
          },
          "outputs": {
            "chartNames": "${{ steps.set-chartname.outputs.chartname }}",
            "runMock": "${{ steps.set-chartname.outputs.run_mock }}"
          },
          "steps": [
            {
              "name": "Clone helm chart repository",
              "uses": "actions/checkout@a37ce9120846195fa4ece8f58b268e6043cb2f26",
              "with": {
                "submodules": true
              }
            },
            {
              "name": "Get changed files",
              "id": "changed-files",
              "uses": "tj-actions/changed-files@ed68ef82c095e0d48ec87eccea555d944a631a4c"
            },
            {
              "name": "Set chartname variable",
              "id": "set-chartname",
              "env": {
                "ALL_CHANGED_FILES": "${{ steps.changed-files.outputs.all_changed_files }}",
                "INPUT_CHART_NAME": "${{ inputs.chartName }}"
              },
              "run": "chartNames=()\nchanged_files=\"${ALL_CHANGED_FILES}\"\nrun_mock=\"0\"\nif [[ -z \"$changed_files\" ]]; then\n  echo \"No changed files detected\"\nelif [[ -n \"${INPUT_CHART_NAME}\" ]]; then\n  chartNames+=(${INPUT_CHART_NAME})\nelse\n  if echo \"$changed_files\" | grep -qE 'rocketchat/'; then\n    chartNames+=(\"rocketchat\")\n    run_mock=1\n  fi\n  if echo \"$changed_files\" | grep -qE 'monitoring/'; then\n    chartNames+=(\"monitoring\")\n    run_mock=1\n  fi\n  if echo \"$changed_files\" | grep -qE 'rocketchat-livekit/'; then\n    chartNames+=(\"rocketchat-livekit\")\n    run_mock=1\n  fi\n  # if ci things are changed retest all charts\n  if echo \"$changed_files\" | grep -qE 'bats/|mock/|test.yml|task.bash'; then\n    chartNames+=(\"rocketchat\" \"monitoring\" \"rocketchat-livekit\")\n    run_mock=1\n  fi\nfi\n\n# Remove duplicates\nunique_chartNames=($(printf \"%s\\n\" \"${chartNames[@]}\" | sort -u))\n\n# Build JSON array string\njson_array=$(printf '\"%s\",' \"${unique_chartNames[@]}\")\njson_array=\"[${json_array%,}]\"\necho \"runMock=${run_mock}\" | tee -a $GITHUB_OUTPUT\necho \"chartname=${json_array}\" | tee -a $GITHUB_OUTPUT\n"
            }
