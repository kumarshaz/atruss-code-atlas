      "jobs": {
        "prepare": {
          "name": "Prepare skills and CLI",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 5,
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version": "24",
                "package-manager-cache": false
              }
            },
            {
              "name": "Install publishing dependencies once",
              "run": "npm ci --prefix \"halo-skill-publishing\" --ignore-scripts --no-audit --no-fund"
            },
            {
              "run": "node \"halo-skill-publishing/prepare-halo-skills.mjs\" .halo-skills"
            },
            {
              "name": "Upload prepared skills",
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "with": {
                "name": "halo-skills",
                "path": ".halo-skills/",
                "include-hidden-files": true,
                "if-no-files-found": "error",
                "retention-days": 2
              }
            },
            {
              "name": "Verify skill commands are available",
              "run": "node \"halo-skill-publishing/node_modules/@langfuse/cli/bin/langfuse.mjs\" skills push --help"
            },
            {
              "name": "Upload Langfuse CLI",
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "with": {
                "name": "halo-cli",
                "path": "halo-skill-publishing/node_modules/@langfuse/cli/",
