    {
      "id": "release.yml",
      "path": ".github/workflows/release.yml",
      "name": "Release",
      "triggers": [
        "workflow_dispatch",
        "push"
      ],
      "jobs": {
        "prepare": {
          "name": "Open release pull request",
          "if": "github.event_name == 'workflow_dispatch'",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "pull-requests": "write"
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "name": "Bump the documented module version",
              "env": {
                "VERSION": "${{ inputs.version }}"
              },
              "run": "[[ \"$VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo \"Unsupported version format: '$VERSION'\" >&2; exit 1; }\nperl -pi -e 's{\\?ref=[^\"]+}{?ref=$ENV{VERSION}}g' README.md\ngit diff --quiet -- README.md && { echo \"README.md already documents $VERSION\" >&2; exit 1; }\nexit 0\n"
            },
            {
              "name": "Create pull request",
              "uses": "peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1",
              "with": {
                "token": "${{ secrets.GITHUB_TOKEN }}",
                "commit-message": "chore: bump version to ${{ inputs.version }}",
                "title": "chore: bump version to ${{ inputs.version }}",
                "body": "Merging this creates the `${{ inputs.version }}` tag and publishes a GitHub release.",
                "branch": "release/${{ inputs.version }}",
                "delete-branch": true
              }
            }
          ]
        },
        "release": {
          "name": "Tag and publish release",
          "if": "github.event_name == 'push'",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write"
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "name": "Tag and release the documented version",
              "env": {
                "GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              },
              "run": "VERSION=$(grep -oE '\\?ref=[^\"]+' README.md | head -1 | cut -d= -f2)\n[[ \"$VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo \"README.md documents '$VERSION', which is not a release version.\"; exit 0; }\nif gh api \"repos/$GITHUB_REPOSITORY/git/ref/tags/$VERSION\" >/dev/null 2>&1; then\n  echo \"Tag $VERSION already exists.\"\n  exit 0\nfi\n# Creates the tag at this commit along with the release.\ngh release create \"$VERSION\" --title \"$VERSION\" --generate-notes --target \"$GITHUB_SHA\"\n"
            }
          ]
        }
      },
