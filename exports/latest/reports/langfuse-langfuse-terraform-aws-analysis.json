              "id": "dirs",
              "run": "dirs=$(for d in . examples/*/; do\n  d=${d%/}\n  ls \"$d\"/*.tf >/dev/null 2>&1 && printf '%s\\n' \"$d\"\ndone | jq -R . | jq -sc .)\necho \"Validating: $dirs\"\necho \"dirs=$dirs\" >> \"$GITHUB_OUTPUT\"\n"
