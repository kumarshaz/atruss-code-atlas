            {
              "name": "Find Next Version",
              "id": "version",
              "run": "declare -i newpost\nlatest=$(git describe --tags $(git rev-list --tags --max-count=1))\nlatestpre=$(echo \"$latest\" | awk '{split($0,a,\".\"); print a[1] \".\" a[2]}')\ndatepre=$(date --utc '+%Y.%m')\n\n\nif [[ \"$latestpre\" == \"$datepre\" ]]; then\n    latestpost=$(echo \"$latest\" | awk '{split($0,a,\".\"); print a[3]}')\n    newpost=$latestpost+1\nelse\n    newpost=0\nfi\n\necho Current version:    $latest\necho New target version: $datepre.$newpost\necho \"version=$datepre.$newpost\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Run Release Drafter",
              "uses": "release-drafter/release-drafter@978bb0b30c5ee8cdd332ced253758157150d43f0",
              "with": {
                "tag": "${{ steps.version.outputs.version }}",
                "name": "${{ steps.version.outputs.version }}"
              },
              "env": {
                "GITHUB_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              }
            }
          ]
        }
      },
