              "run": "docker buildx imagetools inspect \"$IMAGE_REF\" --raw > manifest.json\njq -e '[.manifests[].platform | select(.os == \"linux\") | .architecture] | sort == [\"amd64\", \"arm64\"]' manifest.json\n"
            }
          ]
        }
