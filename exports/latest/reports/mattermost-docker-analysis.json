    {
      "id": "docker-test.yml",
      "path": ".github/workflows/docker-test.yml",
      "name": "Docker Test",
      "triggers": [
        "push",
        "pull_request"
      ],
      "jobs": {
        "validate-compose-files": {
          "name": "Validate Docker Compose Files",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/checkout@v3"
            },
            {
              "name": "Setup environment file",
              "run": "cp env.example .env\n"
            },
            {
              "name": "Validate base docker-compose file",
              "run": "docker compose config"
            },
            {
              "name": "Validate docker-compose with NGINX",
              "run": "docker compose -f docker-compose.yml -f docker-compose.nginx.yml config\n"
            },
            {
              "name": "Validate docker-compose without NGINX",
              "run": "docker compose -f docker-compose.yml -f docker-compose.without-nginx.yml config"
            }
          ]
        },
        "test-docker-deployment": {
          "name": "Test Docker Deployment",
          "runs-on": "ubuntu-latest",
          "needs": "validate-compose-files",
          "steps": [
            {
              "uses": "actions/checkout@v3"
            },
            {
              "name": "Create required directories",
              "run": "mkdir -p ./volumes/app/mattermost/{config,data,logs,plugins,client/plugins,bleve-indexes}\nsudo chown -R 2000:2000 ./volumes/app/mattermost\n"
            },
            {
              "name": "Setup environment file",
              "run": "cp env.example .env\nsed -i 's/DOMAIN=mm.example.com/DOMAIN=localhost/g' .env\n"
            },
            {
              "name": "Start Mattermost without NGINX",
              "run": "# Configure docker-compose to use without-nginx setup\ndocker compose -f docker-compose.yml -f docker-compose.without-nginx.yml up -d\n"
            },
            {
              "name": "Verify containers are running",
              "run": "# Allow time for containers to start\nsleep 30\ndocker ps\ndocker compose ps\n"
            },
            {
              "name": "Check container logs",
              "run": "# Check logs for any issues\ndocker compose logs mattermost --tail 20\ndocker compose logs postgres --tail 20\n"
            },
            {
              "name": "Verify Mattermost API is accessible",
              "run": "# Check that API is responding\ncurl -f --retry 10 --retry-delay 5 --retry-connrefused http://localhost:8065/api/v4/system/ping || exit 1\n"
            },
            {
              "name": "Stop containers",
              "run": "# Clean up containers\ndocker compose down\n",
              "if": "always()"
            }
          ]
        }
      },
