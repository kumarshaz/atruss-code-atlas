  "pipelines": [
    {
      "id": "ci.yml",
      "path": ".github/workflows/ci.yml",
      "name": "ci",
      "triggers": [
        "pull_request",
        "workflow_dispatch",
        "push",
        "schedule"
      ],
      "jobs": {
        "test": {
          "name": "test @ elixir:${{ matrix.elixir }} otp:${{ matrix.otp }} clickhouse:${{ matrix.clickhouse }}${{ matrix.dialyzer && ' +dialyzer' || '' }}${{ matrix.lint && ' +lint' || '' }}",
          "runs-on": "ubuntu-24.04",
          "env": {
            "MIX_ENV": "test"
          },
          "strategy": {
            "matrix": {
              "include": [
                {
                  "elixir": 1.15,
                  "otp": 25,
                  "clickhouse": "24.5.4.49"
                },
                {
                  "elixir": ">0",
                  "otp": ">0",
                  "clickhouse": "latest",
                  "dialyzer": true,
                  "lint": true
                },
                {
                  "elixir": "1.20.2",
                  "otp": "28.5.0.3",
                  "clickhouse": "25.11.5.8"
                }
              ]
            }
          },
          "services": {
            "clickhouse": {
              "image": "clickhouse/clickhouse-server:${{ matrix.clickhouse }}",
              "ports": [
                "8123:8123"
              ],
              "env": {
                "CLICKHOUSE_SKIP_USER_SETUP": "1"
              },
              "options": "--health-cmd \"wget --no-verbose --tries=1 --spider http://127.0.0.1:8123/ping\" --health-interval 10s --health-timeout 5s --health-retries 5"
            }
          },
          "steps": [
            {
              "uses": "actions/checkout@v7"
            },
            {
              "id": "beam",
              "uses": "erlef/setup-beam@v1",
              "with": {
                "elixir-version": "${{ matrix.elixir }}",
                "otp-version": "${{ matrix.otp }}"
              }
            },
            {
              "name": "Restore deps cache",
              "uses": "actions/cache@v6",
              "with": {
                "path": "deps\n_build\n",
                "key": "test-${{ steps.beam.outputs.elixir-version }}-${{ github.head_ref || github.ref }}-${{ hashFiles('**/mix.lock') }}",
                "restore-keys": "test-${{ steps.beam.outputs.elixir-version }}-${{ github.head_ref || github.ref }}-\ntest-${{ steps.beam.outputs.elixir-version }}-refs/heads/master-\n"
              }
            },
            {
              "run": "mix deps.get --only $MIX_ENV",
              "if": "${{ !matrix.lint }}"
            },
            {
              "run": "mix deps.get --check-locked",
              "if": "${{ matrix.lint }}"
            },
            {
              "run": "mix deps.unlock --check-unused",
              "if": "${{ matrix.lint }}"
            },
            {
              "run": "mix compile --warnings-as-errors"
            },
            {
              "run": "mix format --check-formatted",
              "if": "${{ matrix.lint }}"
            },
            {
              "run": "mix test --include slow"
            },
            {
              "name": "Restore PLTs cache",
              "if": "${{ matrix.dialyzer }}",
              "uses": "actions/cache@v6",
              "with": {
                "path": "plts",
                "key": "plts-${{ steps.beam.outputs.elixir-version }}-${{ github.head_ref || github.ref }}",
                "restore-keys": "plts-${{ steps.beam.outputs.elixir-version }}-refs/heads/master\n"
              }
            },
            {
              "run": "mix dialyzer --format github",
              "if": "${{ matrix.dialyzer }}"
            },
            {
              "uses": "crate-ci/typos@master",
              "if": "${{ matrix.lint }}"
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "test",
          "name": "test @ elixir:${{ matrix.elixir }} otp:${{ matrix.otp }} clickhouse:${{ matrix.clickhouse }}${{ matrix.dialyzer && ' +dialyzer' || '' }}${{ matrix.lint && ' +lint' || '' }}",
          "runner": "ubuntu-24.04",
