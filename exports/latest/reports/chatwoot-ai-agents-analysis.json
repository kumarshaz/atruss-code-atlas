  "pipelines": [
    {
      "id": "live_llm.yml",
      "path": ".github/workflows/live_llm.yml",
      "name": "Live LLM Smoke",
      "triggers": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": {
        "live-llm": {
          "if": "github.ref == 'refs/heads/main' || github.event_name == 'workflow_dispatch'",
          "runs-on": "ubuntu-latest",
          "env": {
            "RUN_LIVE_LLM": "true",
            "OPENROUTER_API_KEY": "${{ secrets.OPENROUTER_API_KEY }}",
            "OPENROUTER_MODEL": "${{ inputs.model || vars.OPENROUTER_MODEL || 'openai/gpt-4.1-nano' }}",
            "LANGFUSE_PUBLIC_KEY": "${{ secrets.LANGFUSE_PUBLIC_KEY }}",
            "LANGFUSE_SECRET_KEY": "${{ secrets.LANGFUSE_SECRET_KEY }}",
            "LANGFUSE_HOST": "${{ secrets.LANGFUSE_HOST }}"
          },
          "steps": [
            {
              "uses": "actions/checkout@v4"
            },
            {
              "name": "Set up Ruby",
              "uses": "ruby/setup-ruby@v1",
              "with": {
                "ruby-version": "3.4",
                "bundler-cache": true
              }
            },
            {
              "name": "Verify secrets",
              "run": "if [ -z \"$OPENROUTER_API_KEY\" ]; then\n  echo \"OPENROUTER_API_KEY is not configured; live LLM smoke tests skipped.\" >&2\n  exit 1\nfi\n"
            },
            {
              "name": "Run live LLM smoke tests",
              "run": "bundle exec rspec --tag live_llm"
            }
          ]
        }
      },
