      "id": "sync-dist.yml",
      "path": ".github/workflows/sync-dist.yml",
      "name": "Sync dist",
      "triggers": [
        "push"
      ],
      "jobs": {
        "rebuild-dist": {
          "name": "Rebuild dist",
          "runs-on": "ubuntu-26.04",
          "timeout-minutes": 15,
          "outputs": {
            "base-sha": "${{ steps.rebuild.outputs.base-sha }}",
            "changed": "${{ steps.rebuild.outputs.changed }}"
          },
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "uses": "pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115"
            },
            {
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version": 26,
                "cache": "pnpm",
                "cache-dependency-path": "pnpm-lock.yaml"
              }
            },
            {
              "name": "Rebuild dist against the tip of main",
              "id": "rebuild",
              "run": "git fetch origin main\ngit reset --hard FETCH_HEAD\nbase_sha=$(git rev-parse HEAD)\necho \"base-sha=$base_sha\" >> \"$GITHUB_OUTPUT\"\n\npnpm install --frozen-lockfile\npnpm build\nif [ -z \"$(git status --porcelain dist/)\" ]; then\n  echo \"dist matches the build output - nothing to sync\"\n  echo \"changed=false\" >> \"$GITHUB_OUTPUT\"\n  exit 0\nfi\n\necho \"changed=true\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Upload rebuilt dist",
              "if": "steps.rebuild.outputs.changed == 'true'",
              "uses": "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9",
              "with": {
                "name": "rebuilt-dist",
                "path": "dist/",
                "if-no-files-found": "error",
                "retention-days": 1
              }
            }
          ]
        },
        "sync-dist": {
          "name": "Sync dist",
          "needs": "rebuild-dist",
          "if": "needs.rebuild-dist.outputs.changed == 'true'",
          "runs-on": "ubuntu-26.04",
          "timeout-minutes": 5,
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "ref": "${{ needs.rebuild-dist.outputs.base-sha }}",
                "persist-credentials": false
              }
            },
            {
              "name": "Download rebuilt dist",
              "uses": "actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333",
              "with": {
                "name": "rebuilt-dist",
                "path": "dist/"
              }
            },
            {
              "name": "Commit and push rebuilt dist",
              "shell": "bash",
              "env": {
                "BASE_SHA": "${{ needs.rebuild-dist.outputs.base-sha }}",
                "SYNC_DIST_GH_TOKEN": "${{ secrets.SYNC_DIST_GH_TOKEN }}"
              },
              "run": "if [ -z \"$SYNC_DIST_GH_TOKEN\" ]; then\n  echo \"::error::SYNC_DIST_GH_TOKEN is not configured\"\n  exit 1\nfi\n\ngit config user.name \"github-actions[bot]\"\ngit config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\ngit add dist/\ngit commit -m \"Rebuilt dist after dependency updates\"\n\n# This is a fine-grained PAT limited to this repository with only\n# Contents: read and write. Its owner belongs to Ghost Foundation so\n# the standard ruleset permits this generated commit on main.\nauth_header=$(printf 'x-access-token:%s' \"$SYNC_DIST_GH_TOKEN\" | base64 | tr -d '\\n')\nif git -c http.https://github.com/.extraheader=\"AUTHORIZATION: basic $auth_header\" push origin HEAD:main; then\n  exit 0\nfi\n\ngit fetch origin main\nif [ \"$(git rev-parse FETCH_HEAD)\" != \"$BASE_SHA\" ]; then\n  echo \"main moved after the rebuild; its queued sync-dist run will rebuild the new tip\"\n  exit 0\nfi\n\necho \"Failed to push the rebuilt dist while main was unchanged\"\nexit 1\n"
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "rebuild-dist",
          "name": "Rebuild dist",
          "runner": "ubuntu-26.04",
          "steps_count": 5,
          "needs": [],
          "environment": null
        },
        {
          "id": "sync-dist",
          "name": "Sync dist",
          "runner": "ubuntu-26.04",
          "steps_count": 3,
          "needs": [
            "rebuild-dist"
          ],
          "environment": null
        }
      ],
