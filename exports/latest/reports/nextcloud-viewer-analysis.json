    {
      "id": "npm-audit-fix.yml",
      "path": ".github/workflows/npm-audit-fix.yml",
      "name": "Npm audit fix and compile",
      "triggers": [
        "workflow_dispatch",
        "schedule"
      ],
      "jobs": {
        "build": {
          "runs-on": "ubuntu-latest",
          "env": {
            "AUTOMERGE": true
          },
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "branches": [
                "stable35",
                "stable34",
                "stable33"
              ]
            }
          },
          "name": "npm-audit-fix-${{ matrix.branches }}",
          "steps": [
            {
              "name": "Checkout",
              "id": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false,
                "ref": "${{ matrix.branches }}"
              },
              "continue-on-error": true
            },
            {
              "name": "Check for active merge freeze",
              "id": "freeze",
              "if": "steps.checkout.outcome == 'success'",
              "env": {
                "BRANCH_NAME": "${{ matrix.branches }}"
              },
              "run": "if [[ ! -f .github/workflows/block-merge-freeze.yml ]]; then\n  echo 'No block-merge-freeze workflow, continuing'\n  exit 0\nfi\nif [[ \"$BRANCH_NAME\" == 'main' || \"$BRANCH_NAME\" == 'master' ]]; then\n  SERVER_REF='master'\nelif [[ \"$BRANCH_NAME\" =~ ^stable[0-9]+$ ]]; then\n  SERVER_REF=\"$BRANCH_NAME\"\nelse\n  echo 'Not based on master/main/stable*, so skipping freeze check'\n  exit 0\nfi\ncurl -sf \"https://raw.githubusercontent.com/nextcloud/server/$SERVER_REF/version.php\" --output version.php\nif grep 'OC_VersionString' version.php | grep -q -i -E '(\\.0\\.0 RC[3-9]|\\.[1-9][0-9]* RC)'; then\n  echo \"Merge freeze is active for $SERVER_REF, skipping\"\n  echo 'active=true' >> $GITHUB_OUTPUT\nfi\nrm version.php\n"
            },
            {
              "name": "Read package.json node and npm engines version",
              "if": "steps.freeze.outputs.active != 'true'",
              "uses": "nextcloud-libraries/parse-package-engines-action@39fcc545a815c353dd0a3fd8fd2ef6e59fd02b92",
              "id": "versions"
            },
            {
              "name": "Set up node ${{ steps.versions.outputs.node-version }}",
              "if": "steps.freeze.outputs.active != 'true'",
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version": "${{ steps.versions.outputs.node-version }}"
              }
            },
            {
              "name": "Set up npm ${{ steps.versions.outputs.package-manager-version }}",
              "if": "steps.freeze.outputs.active != 'true'",
              "run": "npm i -g 'npm@${{ steps.versions.outputs.package-manager-version }}'"
            },
            {
              "name": "Fix npm audit",
              "id": "npm-audit",
              "if": "steps.freeze.outputs.active != 'true'",
              "uses": "nextcloud-libraries/npm-audit-action@1b1728b2b4a7a78d69de65608efcf4db0e3e42d0"
            },
            {
              "name": "Run npm ci and npm run build",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success'",
              "env": {
                "CYPRESS_INSTALL_BINARY": 0
              },
              "run": "npm ci\nnpm run build --if-present\n"
            },
            {
              "name": "Create Pull Request",
              "id": "create-pull-request",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success'",
              "uses": "peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1",
              "with": {
                "token": "${{ secrets.COMMAND_BOT_PAT }}",
                "commit-message": "fix(deps): Fix npm audit",
                "committer": "GitHub <noreply@github.com>",
                "author": "nextcloud-command <nextcloud-command@users.noreply.github.com>",
                "signoff": true,
                "branch": "automated/noid/${{ matrix.branches }}-fix-npm-audit",
                "title": "[${{ matrix.branches }}] Fix npm audit",
                "body": "${{ steps.npm-audit.outputs.markdown }}",
                "labels": "dependencies\n3. to review\n"
              }
            },
            {
              "name": "GitHub actions bot approve",
              "if": "steps.freeze.outputs.active != 'true' && steps.create-pull-request.outputs.pull-request-operation != 'none'",
              "run": "gh pr review --approve \"$PR_URL\"",
              "env": {
                "PR_URL": "${{ steps.create-pull-request.outputs.pull-request-url }}",
                "GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Enable auto merge",
              "if": "steps.freeze.outputs.active != 'true' && steps.create-pull-request.outputs.pull-request-operation != 'none' && fromJSON(env.AUTOMERGE)",
              "uses": "peter-evans/enable-pull-request-automerge@a660677d5469627102a1c1e11409dd063606628d",
              "with": {
                "token": "${{ secrets.GITHUB_TOKEN }}",
                "pull-request-number": "${{ steps.create-pull-request.outputs.pull-request-number }}"
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "build",
          "name": "npm-audit-fix-${{ matrix.branches }}",
