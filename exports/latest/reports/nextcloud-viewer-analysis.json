  "pipelines": [
    {
      "id": "command-compile.yml",
      "path": ".github/workflows/command-compile.yml",
      "name": "Compile Command",
      "triggers": [
        "issue_comment"
      ],
      "jobs": {
        "init": {
          "runs-on": "ubuntu-latest-low",
          "if": "github.event.issue.pull_request != '' && startsWith(github.event.comment.body, '/compile')",
          "outputs": {
            "git_path": "${{ steps.git-path.outputs.path }}",
            "arg1": "${{ steps.command.outputs.arg1 }}",
            "arg2": "${{ steps.command.outputs.arg2 }}",
            "head_ref": "${{ steps.comment-branch.outputs.head_ref }}",
            "base_ref": "${{ steps.comment-branch.outputs.base_ref }}"
          },
          "steps": [
            {
              "name": "Get repository from pull request comment",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "id": "get-repository",
              "with": {
                "github-token": "${{secrets.GITHUB_TOKEN}}",
                "script": "const pull = await github.rest.pulls.get({\n  owner: context.repo.owner,\n  repo: context.repo.repo,\n  pull_number: context.issue.number\n});\n\nconst repositoryName = pull.data.head?.repo?.full_name\nconsole.log(repositoryName)\nreturn repositoryName\n"
              }
            },
            {
              "name": "Disabled on forks",
              "if": "${{ fromJSON(steps.get-repository.outputs.result) != github.repository }}",
              "run": "echo 'Can not execute /compile on forks'\nexit 1\n"
            },
            {
              "name": "Check actor permission",
              "uses": "skjnldsv/check-actor-permission@69e92a3c4711150929bca9fcf34448c5bf5526e7",
              "with": {
                "require": "write"
              }
            },
            {
              "name": "Add reaction on start",
              "uses": "peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9",
              "with": {
                "token": "${{ secrets.COMMAND_BOT_PAT }}",
                "repository": "${{ github.event.repository.full_name }}",
                "comment-id": "${{ github.event.comment.id }}",
                "reactions": "+1"
              }
            },
            {
              "name": "Parse command",
              "uses": "skjnldsv/parse-command-comment@5c955203c52424151e6d0e58fb9de8a9f6a605a1",
              "id": "command"
            },
            {
              "name": "Init path",
              "id": "git-path",
              "run": "if ${{ startsWith(steps.command.outputs.arg1, '/') }}; then\n  echo \"path=${{steps.command.outputs.arg1}}\" >> $GITHUB_OUTPUT\nelse\n  echo \"path=${{steps.command.outputs.arg2}}\" >> $GITHUB_OUTPUT\nfi\n"
            },
            {
              "name": "Init branch",
              "uses": "xt0rted/pull-request-comment-branch@e8b8daa837e8ea7331c0003c9c316a64c6d8b0b1",
              "id": "comment-branch"
            },
            {
              "name": "Add reaction on failure",
              "uses": "peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9",
              "if": "failure()",
              "with": {
                "token": "${{ secrets.COMMAND_BOT_PAT }}",
                "repository": "${{ github.event.repository.full_name }}",
                "comment-id": "${{ github.event.comment.id }}",
                "reactions": "-1"
              }
            }
          ]
        },
        "process": {
          "runs-on": "ubuntu-latest",
          "needs": "init",
          "steps": [
            {
              "name": "Restore cached git repository",
              "uses": "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
              "with": {
                "path": ".git",
                "key": "git-repo"
              }
            },
            {
              "name": "Checkout ${{ needs.init.outputs.head_ref }}",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false,
                "token": "${{ secrets.COMMAND_BOT_PAT }}",
                "fetch-depth": 0,
                "ref": "${{ needs.init.outputs.head_ref }}"
              }
            },
            {
              "name": "Setup git",
              "run": "git config --local user.email 'nextcloud-command@users.noreply.github.com'\ngit config --local user.name 'nextcloud-command'\n"
            },
            {
              "name": "Read package.json node and npm engines version",
              "uses": "skjnldsv/read-package-engines-version-actions@06d6baf7d8f41934ab630e97d9e6c0bc9c9ac5e4",
              "id": "package-engines-versions",
              "with": {
                "fallbackNode": "^24",
                "fallbackNpm": "^11.3"
              }
            },
            {
              "name": "Set up node ${{ steps.package-engines-versions.outputs.nodeVersion }}",
              "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020",
              "with": {
                "node-version": "${{ steps.package-engines-versions.outputs.nodeVersion }}",
                "cache": "npm"
              }
            },
            {
              "name": "Set up npm ${{ steps.package-engines-versions.outputs.npmVersion }}",
              "run": "npm i -g 'npm@${{ steps.package-engines-versions.outputs.npmVersion }}'"
            },
            {
              "name": "Rebase to ${{ needs.init.outputs.base_ref }}",
              "if": "${{ contains(needs.init.outputs.arg1, 'rebase') }}",
              "env": {
                "BASE_REF": "${{ needs.init.outputs.base_ref }}"
              },
              "run": "git fetch origin \"${BASE_REF}:${BASE_REF}\"\n\n# Start the rebase\ngit rebase \"origin/${BASE_REF}\" || {\n  # Handle rebase conflicts in a loop\n  while [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; do\n    echo \"Handling rebase conflict...\"\n\n    # Remove and checkout /dist and /js folders from the base branch\n    if [ -d \"dist\" ]; then\n      rm -rf dist\n      git checkout \"origin/${BASE_REF}\" -- dist/ 2>/dev/null || echo \"No dist folder in base branch\"\n    fi\n    if [ -d \"js\" ]; then\n      rm -rf js\n      git checkout \"origin/${BASE_REF}\" -- js/ 2>/dev/null || echo \"No js folder in base branch\"\n    fi\n\n    # Stage all changes\n    git add .\n\n    # Check if there are any changes after resolving conflicts\n    if git diff --cached --quiet; then\n      echo \"No changes after conflict resolution, skipping commit\"\n      git rebase --skip\n    else\n      echo \"Changes found, continuing rebase without editing commit message\"\n      git -c core.editor=true rebase --continue\n    fi\n\n    # Break if rebase is complete\n    if [ ! -d .git/rebase-merge ] && [ ! -d .git/rebase-apply ]; then\n      break\n    fi\n  done\n}\n"
            },
            {
              "name": "Install dependencies & build",
              "env": {
                "CYPRESS_INSTALL_BINARY": 0,
                "PUPPETEER_SKIP_DOWNLOAD": true
              },
              "run": "npm ci\nnpm run build --if-present\n"
            },
            {
              "name": "Commit default",
              "if": "${{ !contains(needs.init.outputs.arg1, 'fixup') && !contains(needs.init.outputs.arg1, 'amend') }}",
              "env": {
                "GIT_PATH": "${{ needs.init.outputs.git_path }}"
              },
              "run": "git add \"${GITHUB_WORKSPACE}${GIT_PATH}\"\ngit commit --signoff -m 'chore(assets): Recompile assets'\n"
            },
            {
              "name": "Commit fixup",
              "if": "${{ contains(needs.init.outputs.arg1, 'fixup') }}",
              "env": {
                "GIT_PATH": "${{ needs.init.outputs.git_path }}"
              },
              "run": "git add \"${GITHUB_WORKSPACE}${GIT_PATH}\"\ngit commit --fixup=HEAD --signoff\n"
            },
            {
              "name": "Commit amend",
              "if": "${{ contains(needs.init.outputs.arg1, 'amend') }}",
              "env": {
                "GIT_PATH": "${{ needs.init.outputs.git_path }}"
              },
              "run": "git add \"${GITHUB_WORKSPACE}${GIT_PATH}\"\ngit commit --amend --no-edit --signoff\n# Remove any [skip ci] from the amended commit\ngit commit --amend -m \"$(git log -1 --format='%B' | sed '/\\[skip ci\\]/d')\"\n"
            },
            {
              "name": "Push normally",
              "if": "${{ !contains(needs.init.outputs.arg1, 'rebase') && !contains(needs.init.outputs.arg1, 'amend') }}",
              "env": {
                "HEAD_REF": "${{ needs.init.outputs.head_ref }}",
                "BOT_TOKEN": "${{ secrets.COMMAND_BOT_PAT }}"
              },
              "run": "git remote set-url origin \"https://x-access-token:${BOT_TOKEN}@github.com/${{ github.repository }}.git\"\ngit push origin \"$HEAD_REF\"\n"
            },
            {
              "name": "Force push",
              "if": "${{ contains(needs.init.outputs.arg1, 'rebase') || contains(needs.init.outputs.arg1, 'amend') }}",
              "env": {
                "HEAD_REF": "${{ needs.init.outputs.head_ref }}",
                "BOT_TOKEN": "${{ secrets.COMMAND_BOT_PAT }}"
              },
              "run": "git remote set-url origin \"https://x-access-token:${BOT_TOKEN}@github.com/${{ github.repository }}.git\"\ngit push --force-with-lease origin \"$HEAD_REF\"\n"
            },
            {
              "name": "Add reaction on failure",
              "uses": "peter-evans/create-or-update-comment@e8674b075228eee787fea43ef493e45ece1004c9",
              "if": "failure()",
              "with": {
                "token": "${{ secrets.COMMAND_BOT_PAT }}",
                "repository": "${{ github.event.repository.full_name }}",
                "comment-id": "${{ github.event.comment.id }}",
                "reactions": "-1"
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "init",
          "name": "init",
          "runner": "ubuntu-latest-low",
          "steps_count": 8,
          "needs": [],
          "environment": null
