              "with": {
                "files": "vendor-bin/nextcloud-ocp/composer.json"
              }
            },
            {
              "name": "Composer update nextcloud/ocp",
              "id": "update_branch",
              "if": "steps.freeze.outputs.active != 'true'",
              "env": {
                "USE_COMPOSER_BIN": "${{ steps.check_composer_bin.outputs.files_exists }}",
                "BRANCH_NAME": "${{ matrix.branches }}"
              },
              "run": "COMPOSER_CMD='composer'\nif [[ \"$USE_COMPOSER_BIN\" == 'true' ]]; then\n  COMPOSER_CMD='composer bin nextcloud-ocp'\nfi\n\nPACKAGE_VERSION=\"nextcloud/ocp:dev-$BRANCH_NAME\"\nif [[ \"$BRANCH_NAME\" == 'main' ]]; then\n  PACKAGE_VERSION='nextcloud/ocp:dev-master'\nfi\n\necho $COMPOSER_CMD require --dev $PACKAGE_VERSION\n$COMPOSER_CMD require --dev $PACKAGE_VERSION\n"
            },
            {
              "name": "Raise on issue on failure",
              "uses": "dacbd/create-issue-action@cdb57ab6ff8862aa09fee2be6ba77a59581921c2",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success' && failure() && steps.update_branch.conclusion == 'failure'",
              "with": {
