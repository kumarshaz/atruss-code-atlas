      "id": "update-nextcloud-ocp.yml",
      "path": ".github/workflows/update-nextcloud-ocp.yml",
      "name": "Update nextcloud/ocp",
      "triggers": [
        "workflow_dispatch",
        "schedule"
      ],
      "jobs": {
        "update-nextcloud-ocp": {
          "runs-on": "ubuntu-latest",
          "if": "${{ github.repository_owner == 'nextcloud' }}",
          "env": {
            "AUTOMERGE": true
          },
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "branches": [
                "stable35",
                "stable34",
                "stable33"
              ]
            }
          },
          "name": "update-nextcloud-ocp-${{ matrix.branches }}",
          "steps": [
            {
              "id": "checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false,
                "ref": "${{ matrix.branches }}",
                "submodules": true
              },
              "continue-on-error": true
            },
            {
              "name": "Check for active merge freeze",
              "id": "freeze",
              "if": "steps.checkout.outcome == 'success'",
              "env": {
                "BRANCH_NAME": "${{ matrix.branches }}"
              },
              "run": "if [[ ! -f .github/workflows/block-merge-freeze.yml ]]; then\n  echo 'No block-merge-freeze workflow, continuing'\n  exit 0\nfi\nif [[ \"$BRANCH_NAME\" == 'main' || \"$BRANCH_NAME\" == 'master' ]]; then\n  SERVER_REF='master'\nelif [[ \"$BRANCH_NAME\" =~ ^stable[0-9]+$ ]]; then\n  SERVER_REF=\"$BRANCH_NAME\"\nelse\n  echo 'Not based on master/main/stable*, so skipping freeze check'\n  exit 0\nfi\ncurl -sf \"https://raw.githubusercontent.com/nextcloud/server/$SERVER_REF/version.php\" --output version.php\nif grep 'OC_VersionString' version.php | grep -q -i -E '(\\.0\\.0 RC[3-9]|\\.[1-9][0-9]* RC)'; then\n  echo \"Merge freeze is active for $SERVER_REF, skipping\"\n  echo 'active=true' >> $GITHUB_OUTPUT\nfi\nrm version.php\n"
            },
            {
              "name": "Get php version",
              "id": "versions",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success'",
              "uses": "nextcloud-libraries/nextcloud-version-matrix@cd0211ffcef1065e2020cd579e4843b8746e7a58"
            },
            {
              "name": "Set up php${{ steps.versions.outputs.php-min }}",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success'",
              "uses": "shivammathur/setup-php@eb7c497e18156a6bbabfef1d3a82760b9eda3962",
              "with": {
                "php-version": "${{ steps.versions.outputs.php-min }}",
                "extensions": "bz2, ctype, curl, dom, fileinfo, gd, iconv, intl, json, libxml, mbstring, openssl, pcntl, posix, session, simplexml, xmlreader, xmlwriter, zip, zlib, sqlite, pdo_sqlite",
                "coverage": "none"
              },
              "env": {
                "GITHUB_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Read codeowners",
              "if": "steps.freeze.outputs.active != 'true' && steps.checkout.outcome == 'success'",
              "id": "codeowners",
              "run": "grep '/appinfo/info.xml' .github/CODEOWNERS | cut -f 2- -d ' ' | xargs | awk '{ print \"codeowners=\"$0 }' >> $GITHUB_OUTPUT\n",
              "continue-on-error": true
            },
            {
