      ],
      "jobs": {
        "smoke": {
          "name": "Build against real GitHub",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 15,
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version-file": ".nvmrc"
              }
            },
            {
              "name": "Read Node version",
              "id": "node-version",
              "run": "echo \"version=$(cat .nvmrc)\" >> \"$GITHUB_OUTPUT\""
            },
            {
              "run": "corepack enable"
            },
            {
              "run": "pnpm config set store-dir ~/.pnpm-store"
            },
            {
              "name": "Cache pnpm store",
              "uses": "actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9",
              "with": {
                "path": "~/.pnpm-store",
                "key": "pnpm-${{ runner.os }}-${{ steps.node-version.outputs.version }}-${{ hashFiles('pnpm-lock.yaml') }}",
                "restore-keys": "pnpm-${{ runner.os }}-${{ steps.node-version.outputs.version }}-\n"
              }
            },
            {
              "run": "pnpm install --frozen-lockfile --ignore-scripts"
            },
            {
              "name": "Build site (real GitHub + gist archive)",
              "env": {
                "NODE_CMS_GITHUB_TOKEN": "${{ secrets.NODE_CMS_GITHUB_TOKEN }}"
              },
              "run": "pnpm build"
            },
            {
              "name": "Verify archive gist round-trip",
              "env": {
                "NODE_CMS_GITHUB_TOKEN": "${{ secrets.NODE_CMS_GITHUB_TOKEN }}"
              },
              "run": "node --input-type=module -e \"\nimport { getArchive, authenticate } from './scripts/fetch-archive.js';\nauthenticate();\nconst archive = await getArchive();\nif (!archive) {\n  console.error('FAIL: no archive gist found after build');\n  process.exit(1);\n}\nconst ageHours = (Date.now() - archive.timestamp) / (1000 * 60 * 60);\nif (ageHours > 25) {\n  console.error('FAIL: archive gist timestamp is', ageHours.toFixed(1), 'hours old');\n  process.exit(1);\n}\nconst projectCount = Object.keys(archive.data || {}).length;\nif (projectCount < 10) {\n  console.error('FAIL: archive gist has only', projectCount, 'projects');\n  process.exit(1);\n}\nconsole.log('OK: archive gist has', projectCount, 'projects, age', ageHours.toFixed(1), 'hours');\n\"\n"
            }
          ]
        }
      },
