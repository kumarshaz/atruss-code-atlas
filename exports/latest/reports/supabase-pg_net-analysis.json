  "pipelines": [
    {
      "id": "main.yml",
      "path": ".github/workflows/main.yml",
      "name": "CI",
      "triggers": [
        "pull_request",
        "push"
      ],
      "jobs": {
        "test": {
          "runs-on": "ubuntu-latest",
          "strategy": {
            "matrix": {
              "pg-version": [
                "14",
                "15",
                "16",
                "17",
                "18",
                "19"
              ]
            }
          },
          "steps": [
            {
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
            },
            {
              "name": "Install Nix",
              "uses": "cachix/install-nix-action@c134e4c9e34bac6cab09cf239815f9339aaaf84e"
            },
            {
              "name": "Use Cachix Cache",
              "uses": "cachix/cachix-action@3ba601ff5bbb07c7220846facfa2cd81eeee15a1",
              "with": {
                "name": "nxpg",
                "authToken": "${{ secrets.CACHIX_AUTH_TOKEN }}"
              }
            },
            {
              "name": "Check flake.lock/flake.nix for drift",
              "run": "nix flake update\ngit diff --exit-code\n"
            },
            {
              "name": "Build",
              "run": "nix-shell --argstr pgVersion \"${{ matrix.pg-version }}\" --arg cassert true --run \"xpg -v ${{ matrix.pg-version }} build\""
            },
            {
              "name": "Run tests",
              "run": "nix-shell --argstr pgVersion \"${{ matrix.pg-version }}\" --arg cassert true --run \"xpg -v ${{ matrix.pg-version }} test\""
            }
          ]
        },
        "test-on-macos": {
          "runs-on": "macos-26",
          "strategy": {
            "matrix": {
              "pg-version": [
                "17"
              ]
            }
          },
          "steps": [
            {
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "name": "Install Nix",
              "uses": "cachix/install-nix-action@c134e4c9e34bac6cab09cf239815f9339aaaf84e",
              "with": {
                "nix_path": "nixpkgs=channel:nixos-unstable"
              }
            },
            {
              "name": "Use Cachix Cache",
              "uses": "cachix/cachix-action@3ba601ff5bbb07c7220846facfa2cd81eeee15a1",
              "with": {
                "name": "nxpg",
                "authToken": "${{ secrets.CACHIX_AUTH_TOKEN }}"
              }
            },
            {
              "name": "clang analyze",
              "run": "nix-shell --argstr pgVersion \"${{ matrix.pg-version }}\" --arg cassert false --run \"CPPFLAGS='--analyze -Xanalyzer  -analyzer-werror' xpg -v ${{ matrix.pg-version }} build\"\nrm -rf ./build-${{ matrix.pg-version }}\n"
            },
            {
              "name": "Build",
              "run": "nix-shell --argstr pgVersion \"${{ matrix.pg-version }}\" --arg cassert true --run \"xpg -v ${{ matrix.pg-version }} build\""
            },
            {
              "name": "Run tests",
              "run": "export UBSAN_OPTIONS=\"print_stacktrace=1:disable_coredump=0:abort_on_error=1:verbosity=0\"\nnix-shell --argstr pgVersion \"${{ matrix.pg-version }}\" --arg cassert true --run \"xpg -v ${{ matrix.pg-version }} test\"\n"
            }
          ]
        },
        "loadtest": {
          "runs-on": "ubuntu-latest",
          "strategy": {
            "matrix": {
              "params": [
                {
                  "reqs": 10000,
                  "batch": 200
                },
                {
                  "reqs": 20000,
                  "batch": 400
                },
                {
                  "reqs": 40000,
                  "batch": 800
                }
              ]
            }
          },
          "steps": [
            {
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
            },
            {
              "name": "Install Nix",
              "uses": "cachix/install-nix-action@c134e4c9e34bac6cab09cf239815f9339aaaf84e"
            },
            {
              "name": "Use Cachix Cache",
              "uses": "cachix/cachix-action@3ba601ff5bbb07c7220846facfa2cd81eeee15a1",
              "with": {
                "name": "nxpg",
                "authToken": "${{ secrets.CACHIX_AUTH_TOKEN }}"
              }
            },
            {
              "name": "Build",
              "run": "nix-shell --argstr pgVersion \"17\" --arg cassert false --run \"xpg build\""
            },
            {
              "name": "Run load test",
              "run": "nix-shell --argstr pgVersion \"17\" --arg cassert false --run \"net-loadtest ${{ matrix.params.reqs }} ${{ matrix.params.batch }}\" >> \"$GITHUB_STEP_SUMMARY\"\n"
            }
          ]
        },
