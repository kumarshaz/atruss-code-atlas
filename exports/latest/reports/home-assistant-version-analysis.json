  "pipelines": [
    {
      "id": "version.yml",
      "path": ".github/workflows/version.yml",
      "name": "Version",
      "triggers": [
        "workflow_dispatch",
        "pull_request",
        "push"
      ],
      "jobs": {
        "lint": {
          "name": "Lint",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Checkout the repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "name": "Lint with JQ",
              "uses": "home-assistant/actions/helpers/jq@master"
            }
          ]
        },
        "prepare": {
          "name": "Prepare",
          "needs": [
            "lint"
          ],
          "runs-on": "ubuntu-latest",
          "outputs": {
            "files": "${{ steps.calc_file_list.outputs.changed_files }}",
            "sign_matrix": "${{ steps.calc_file_list.outputs.result }}",
            "dispatch_channels": "${{ steps.calc_file_list.outputs.dispatch_channels }}"
          },
          "steps": [
            {
              "name": "Checkout the repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "name": "Get changed files for push",
              "if": "github.event_name == 'push'",
              "id": "changed_files_push",
              "uses": "masesgroup/retrieve-changed-files@45a8b3b496d2d6037cbd553e8a3450989b9384a2",
              "with": {
                "format": "json"
              }
            },
            {
              "name": "Calculate files to sign and push",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "id": "calc_file_list",
              "with": {
                "script": "const signed_files = \"${{ env.SIGNED_FILES }}\".split(' ')\nconst full_image_channels = ['stable']\nconst setDispatchChannels = (files) => core.setOutput(\"dispatch_channels\", JSON.stringify(\n  full_image_channels.filter(channel => files.includes(`${channel}.json`))))\nif (\"${{ github.event_name }}\" === \"push\") {\n  changed_files = JSON.parse('${{ steps.changed_files_push.outputs.all }}')\n  setDispatchChannels(changed_files)\n  // Sign all files in case this workflow changes.\n  if (changed_files.includes(\".github/workflows/version.yml\")) {\n    changed_files = [...new Set([...changed_files, ...signed_files])]\n  }\n  core.setOutput(\"changed_files\", changed_files.join(' '))\n  return changed_files.filter(value => signed_files.includes(value))\n} else {\n  input_files = \"${{ github.event.inputs.files }}\".split(' ')\n  setDispatchChannels(input_files)\n  core.setOutput(\"changed_files\", input_files.join(' '))\n  return input_files.filter(value => signed_files.includes(value))\n}\n"
              }
            }
          ]
        },
        "signing": {
          "name": "Sign ${{ matrix.path }}",
          "needs": [
            "prepare"
          ],
          "if": "${{ (github.event_name == 'push' || github.event_name == 'workflow_dispatch') && needs.prepare.outputs.sign_matrix != '[]' }}",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "id-token": "write",
            "packages": "write"
          },
          "strategy": {
            "matrix": {
              "path": "${{ fromJson(needs.prepare.outputs.sign_matrix) }}"
            }
          },
          "steps": [
            {
              "name": "Checkout the repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "name": "Login to GitHub Container Registry",
              "uses": "docker/login-action@8aa5831fb8d48d8f76594c7ddde61ae58019f550",
              "with": {
                "registry": "ghcr.io",
                "username": "home-assistant",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "uses": "sigstore/cosign-installer@756fe2d284c7292c4e9b62c8a28f1e5629c59532",
              "with": {
                "cosign-release": "${{ env.COSIGN_VERSION }}"
              }
            },
            {
              "name": "Sign Cosign",
              "run": "cosign sign-blob --yes ${{ matrix.path }} --bundle ${{ matrix.path }}.sig\n"
            },
            {
              "name": "Upload signature",
              "env": {
                "AWS_ACCESS_KEY_ID": "${{ secrets.AWS_ACCESS_KEY_ID }}",
                "AWS_SECRET_ACCESS_KEY": "${{ secrets.AWS_SECRET_ACCESS_KEY }}"
              },
              "run": "aws s3 sync . s3://version.home-assistant.io --exclude \"*\" --include \"${{ matrix.path }}.sig\"\n"
            }
          ]
        },
        "upload": {
          "name": "Upload",
          "needs": [
            "signing",
            "prepare"
          ],
          "if": "${{ !failure() && !cancelled() && (github.event_name == 'push' || github.event_name == 'workflow_dispatch') }}",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Checkout the repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "name": "Upload files",
              "env": {
                "AWS_ACCESS_KEY_ID": "${{ secrets.AWS_ACCESS_KEY_ID }}",
                "AWS_SECRET_ACCESS_KEY": "${{ secrets.AWS_SECRET_ACCESS_KEY }}"
              },
              "run": "for file in ${{ needs.prepare.outputs.files }}; do\n  if [[ \"$file\" =~ \\.txt|\\.json|\\.png ]]; then\n    aws s3 sync . s3://version.home-assistant.io --exclude \"*\" --include \"$file\"\n  fi\ndone\n"
            },
            {
              "name": "Gather files for cache flush",
              "id": "flush",
              "run": "declare -a files\nfor file in ${{ needs.prepare.outputs.files }}; do\n  if [[ \"$file\" =~ \\.txt|\\.json ]]; then\n    files+=(\"\\\"https:\\/\\/version.home-assistant.io\\/$file\\\", \")\n    if [[ \"${{ env.SIGNED_FILES }}\" =~ $file ]]; then\n      files+=(\"\\\"https:\\/\\/version.home-assistant.io\\/$file.sig\\\", \")\n    fi\n  fi\ndone\necho \"files=[$(echo ${files[@]} | rev | cut -c 2- | rev)]\" >> $GITHUB_OUTPUT\n"
            },
            {
              "name": "Flush CloudFlare cache",
              "run": "curl --silent --show-error --fail -X POST \\\n  \"https://api.cloudflare.com/client/v4/zones/${{ secrets.CF_ZONE }}/purge_cache\" \\\n  -H \"Authorization: Bearer ${{ secrets.CF_PURGE_TOKEN }}\" \\\n  -H \"Content-Type: application/json\" \\\n  --data '{\"files\": ${{ steps.flush.outputs.files }}}'\n"
            }
          ]
        },
        "dispatch-full-images": {
          "name": "Dispatch full-image builds",
          "needs": [
            "prepare",
            "upload"
          ],
          "if": "!failure() && !cancelled() && needs.upload.result == 'success' && needs.prepare.outputs.dispatch_channels != '[]'",
          "runs-on": "ubuntu-latest",
          "permissions": {},
          "steps": [
            {
              "name": "Dispatch published channels",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "env": {
                "CHANNELS": "${{ needs.prepare.outputs.dispatch_channels }}",
                "VERSION_SHA": "${{ github.sha }}"
              },
              "with": {
                "github-token": "${{ secrets.DISPATCH_TOKEN }}",
                "script": "const owner = 'home-assistant';\nconst repo = 'operating-system-full-images';\nconst { data: target } = await github.rest.repos.get({ owner, repo });\nfor (const channel of JSON.parse(process.env.CHANNELS)) {\n  await github.rest.actions.createWorkflowDispatch({\n    owner, repo, workflow_id: 'build-channel.yml',\n    ref: target.default_branch,\n    inputs: { channel, version_sha: process.env.VERSION_SHA, publish: 'true' },\n  });\n  core.info(`Dispatched ${channel} at ${process.env.VERSION_SHA}`);\n}\n"
              }
            }
          ]
        }
      },
      "job_nodes": [
