      "id": "cleanup-container-images.yml",
      "path": ".github/workflows/cleanup-container-images.yml",
      "name": "Cleanup Container Images",
      "triggers": [
        "delete"
      ],
      "jobs": {
        "cleanup-images": {
          "name": "Delete branch container images",
          "if": "github.event.ref != 'main' &&\ngithub.event.ref != 'rc' &&\ngithub.event.ref != 'hotfix-rc'\n",
          "runs-on": "ubuntu-24.04",
          "permissions": {
            "packages": "write"
          },
          "steps": [
            {
              "name": "Generate image tag to delete",
              "id": "tag",
              "env": {
                "EVENT_REF": "${{ github.event.ref }}"
              },
              "run": "# Sanitize deleted branch name to match build workflow tag generation\nBRANCH_NAME=\"${EVENT_REF}\"\nIMAGE_TAG=$(echo \"$BRANCH_NAME\" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g; s/-+/-/g; s/^-+|-+$//g' | cut -c1-128 | sed -E 's/[.-]$//')\n\nif [[ -z \"$IMAGE_TAG\" ]]; then\n  echo \"ERROR: Failed to generate valid IMAGE_TAG from EVENT_REF: $EVENT_REF\"\n  exit 1\nfi\n\necho \"tag=$IMAGE_TAG\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Delete container image version",
              "env": {
                "GH_TOKEN": "${{ secrets.GITHUB_TOKEN }}",
                "IMAGE_TAG": "${{ steps.tag.outputs.tag }}"
              },
              "run": "# Get the version ID for this specific tag\nVERSION_ID=$(gh api \\\n  -H \"Accept: application/vnd.github+json\" \\\n  -H \"X-GitHub-Api-Version: 2022-11-28\" \\\n  \"/orgs/bitwarden/packages/container/lite/versions\" \\\n  --jq \".[] | select(.metadata.container.tags[] == \\\"$IMAGE_TAG\\\") | .id\" \\\n  | head -1)\n\nif [[ -n \"$VERSION_ID\" ]]; then\n  echo \"Deleting image with tag: $IMAGE_TAG (version ID: $VERSION_ID)\"\n  gh api \\\n    --method DELETE \\\n    -H \"Accept: application/vnd.github+json\" \\\n    -H \"X-GitHub-Api-Version: 2022-11-28\" \\\n    \"/orgs/bitwarden/packages/container/lite/versions/$VERSION_ID\"\n  echo \"Successfully deleted image\"\nelse\n  echo \"No image found with tag: $IMAGE_TAG\"\nfi\n"
            }
          ]
        }
      },
