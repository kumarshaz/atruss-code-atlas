    {
      "id": "build-bitwarden-lite.yml",
      "path": ".github/workflows/build-bitwarden-lite.yml",
      "name": "Build Bitwarden lite",
      "triggers": [
        "push",
        "repository_dispatch",
        "workflow_dispatch",
        "workflow_call",
        "pull_request"
      ],
      "jobs": {
        "check-event-source": {
          "name": "Check event and source",
          "runs-on": "ubuntu-24.04",
          "permissions": {
            "contents": "read"
          },
          "if": "github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository",
          "steps": [
            {
              "name": "Check PR event and source",
              "run": "echo \"Internal PR, push, dispatch, or workflow_call — proceeding\""
            }
          ]
        },
        "setup": {
          "name": "Setup",
          "runs-on": "ubuntu-24.04",
          "needs": "check-event-source",
          "permissions": {
            "contents": "read"
          },
          "outputs": {
            "server_ref": "${{ steps.refs.outputs.server_ref }}",
            "web_ref": "${{ steps.refs.outputs.web_ref }}",
            "image_tag": "${{ steps.finalize.outputs.image_tag }}",
            "server_tag": "${{ steps.finalize.outputs.server_tag }}",
            "web_tag": "${{ steps.finalize.outputs.web_tag }}",
            "web_image": "${{ steps.finalize.outputs.web_image }}",
            "server_registry": "${{ steps.finalize.outputs.server_registry }}",
            "push_to_ghcr": "${{ steps.finalize.outputs.push_to_ghcr }}"
          },
          "steps": [
            {
              "name": "Checkout Repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "ref": "${{ inputs.self_host_repo_ref || github.event.client_payload.self_host_repo_ref || github.ref }}",
                "persist-credentials": false,
                "allow-unsafe-pr-checkout": true
              }
            },
            {
              "name": "Validate inputs and resolve refs",
              "id": "refs",
              "env": {
                "SERVER_BRANCH_INPUT": "${{ inputs.server_branch || github.event.client_payload.server_branch }}",
                "WEB_BRANCH_INPUT": "${{ inputs.web_branch || github.event.client_payload.web_branch }}",
                "OVERRIDE_TAG_INPUT": "${{ inputs.override_tag || github.event.client_payload.override_tag }}",
                "USE_LATEST_CORE_VERSION": "${{ github.event_name == 'repository_dispatch' && github.event.client_payload.use_latest_core_version || inputs.use_latest_core_version }}",
                "USE_LATEST_WEB_VERSION": "${{ github.event_name == 'repository_dispatch' && github.event.client_payload.use_latest_web_version || inputs.use_latest_web_version }}"
              },
              "run": "SERVER_BRANCH=\"$SERVER_BRANCH_INPUT\"\nWEB_BRANCH=\"$WEB_BRANCH_INPUT\"\nOVERRIDE_TAG=\"$OVERRIDE_TAG_INPUT\"\n\n# Reject overrides that collide with reserved tags\ncase \"$OVERRIDE_TAG\" in\n  rc|hotfix-rc|dev)\n    echo \"ERROR: override_tag cannot be a reserved value (rc, hotfix-rc, dev)\"\n    exit 1\n    ;;\nesac\n\n# Branch normalization: both empty -> main; one empty -> mirror the other\nif [[ -z \"$SERVER_BRANCH\" && -z \"$WEB_BRANCH\" ]]; then\n  SERVER_BRANCH=main\n  WEB_BRANCH=main\nelif [[ -z \"$SERVER_BRANCH\" ]]; then\n  SERVER_BRANCH=\"$WEB_BRANCH\"\nelif [[ -z \"$WEB_BRANCH\" ]]; then\n  WEB_BRANCH=\"$SERVER_BRANCH\"\nfi\n\n# Resolve refs (version flags take precedence over branch)\nif [[ \"$USE_LATEST_CORE_VERSION\" == \"true\" ]]; then\n  CORE_VERSION=$(jq -r '.versions.coreVersion' version.json)\n  echo \"Server version from version.json: $CORE_VERSION\"\n  SERVER_REF=\"refs/tags/v$CORE_VERSION\"\nelse\n  SERVER_REF=\"refs/heads/${SERVER_BRANCH#refs/heads/}\"\nfi\n\nif [[ \"$USE_LATEST_WEB_VERSION\" == \"true\" ]]; then\n  WEB_VERSION=$(jq -r '.versions.webVersion' version.json)\n  echo \"Web version from version.json: $WEB_VERSION\"\n  WEB_REF=\"refs/tags/web-v$WEB_VERSION\"\nelse\n  WEB_REF=\"refs/heads/${WEB_BRANCH#refs/heads/}\"\nfi\n\n# Extract version from web's `refs/tags/web-v<version>` format so the\n# sanitize-image-tag action sees just the version string.\nif [[ \"$WEB_REF\" =~ ^refs/tags/web-v(.+)$ ]]; then\n  WEB_REF_FOR_TAG=\"${BASH_REMATCH[1]}\"\nelse\n  WEB_REF_FOR_TAG=\"$WEB_REF\"\nfi\n\necho \"server_ref=$SERVER_REF\" >> \"$GITHUB_OUTPUT\"\necho \"web_ref=$WEB_REF\" >> \"$GITHUB_OUTPUT\"\necho \"web_ref_for_tag=$WEB_REF_FOR_TAG\" >> \"$GITHUB_OUTPUT\"\necho \"server_branch=$SERVER_BRANCH\" >> \"$GITHUB_OUTPUT\"\necho \"web_branch=$WEB_BRANCH\" >> \"$GITHUB_OUTPUT\"\necho \"override_tag=$OVERRIDE_TAG\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Sanitize server tag",
              "id": "sanitize-server",
              "if": "(inputs.server_tag || github.event.client_payload.server_tag) == ''",
              "uses": "bitwarden/gh-actions/sanitize-image-tag@main",
              "with": {
                "ref": "${{ steps.refs.outputs.server_ref }}"
              }
            },
            {
              "name": "Sanitize web tag",
              "id": "sanitize-web",
              "if": "(inputs.web_tag || github.event.client_payload.web_tag) == ''",
              "uses": "bitwarden/gh-actions/sanitize-image-tag@main",
              "with": {
                "ref": "${{ steps.refs.outputs.web_ref_for_tag }}"
              }
            },
            {
              "name": "Resolve final values",
              "id": "finalize",
              "env": {
                "SERVER_REF": "${{ steps.refs.outputs.server_ref }}",
                "WEB_REF": "${{ steps.refs.outputs.web_ref }}",
                "SERVER_BRANCH": "${{ steps.refs.outputs.server_branch }}",
                "WEB_BRANCH": "${{ steps.refs.outputs.web_branch }}",
                "OVERRIDE_TAG": "${{ steps.refs.outputs.override_tag }}",
                "SERVER_TAG_OVERRIDE": "${{ inputs.server_tag || github.event.client_payload.server_tag }}",
                "WEB_TAG_OVERRIDE": "${{ inputs.web_tag || github.event.client_payload.web_tag }}",
                "SERVER_TAG_FROM_ACTION": "${{ steps.sanitize-server.outputs.tag }}",
                "WEB_TAG_FROM_ACTION": "${{ steps.sanitize-web.outputs.tag }}"
              },
              "run": "SERVER_TAG=\"${SERVER_TAG_OVERRIDE:-$SERVER_TAG_FROM_ACTION}\"\nWEB_TAG=\"${WEB_TAG_OVERRIDE:-$WEB_TAG_FROM_ACTION}\"\n\n# Web image: release goes to GHCR `web`; reserved tags (dev/rc/hotfix-rc-web) go to\n# GHCR `web-dev`; everything else (feature branches) is ACR-only at `web`.\nif [[ \"$WEB_REF\" =~ ^refs/tags/web-v ]]; then\n  WEB_IMAGE=\"ghcr.io/bitwarden/web\"\nelif [[ \"$WEB_TAG\" == \"dev\" || \"$WEB_TAG\" == \"rc\" || \"$WEB_TAG\" == \"hotfix-rc-web\" ]]; then\n  WEB_IMAGE=\"ghcr.io/bitwarden/web-dev\"\nelse\n  WEB_IMAGE=\"bitwardenprod.azurecr.io/web\"\nfi\n\n# Bitwarden Lite image tag: override > version > branch agreement.\n# `use_latest_core_version` selects which upstream server code to consume; it does not\n# name the output image. A non-blank override_tag is always honored.\nif [[ -n \"$OVERRIDE_TAG\" ]]; then\n  IMAGE_TAG=\"$OVERRIDE_TAG\"\nelif [[ \"$SERVER_REF\" =~ ^refs/tags/v(.+)$ ]]; then\n  IMAGE_TAG=\"${BASH_REMATCH[1]}\"\nelif [[ \"$SERVER_BRANCH\" == \"$WEB_BRANCH\" ]]; then\n  case \"$SERVER_BRANCH\" in\n    main) IMAGE_TAG=dev ;;\n    rc) IMAGE_TAG=rc ;;\n    hotfix-rc) IMAGE_TAG=hotfix-rc ;;\n    *)\n      echo \"ERROR: override_tag must be specified when server_branch=$SERVER_BRANCH and web_branch=$WEB_BRANCH\"\n      exit 1\n      ;;\n  esac\nelse\n  echo \"ERROR: override_tag must be specified when server_branch=$SERVER_BRANCH and web_branch=$WEB_BRANCH\"\n  exit 1\nfi\n\n# Upstream server registry: GHCR for rc/hotfix-rc/version, ACR otherwise\nif [[ \"$SERVER_TAG\" == \"rc\" || \"$SERVER_TAG\" == \"hotfix-rc\" ]] || [[ \"$SERVER_REF\" =~ ^refs/tags/v ]]; then\n  SERVER_REGISTRY=\"ghcr.io/bitwarden\"\nelse\n  SERVER_REGISTRY=\"bitwardenprod.azurecr.io\"\nfi\n\n# Always push Bitwarden Lite to ACR; also push to GHCR for reserved tags and version tags.\n# A custom override_tag stays ACR-only even when consuming released upstream code: it\n# names a one-off build, not a published artifact. Checked first, because SERVER_REF is\n# a version tag whenever use_latest_core_version=true.\nif [[ -n \"$OVERRIDE_TAG\" ]]; then\n  PUSH_TO_GHCR=false\nelif [[ \"$IMAGE_TAG\" == \"rc\" || \"$IMAGE_TAG\" == \"hotfix-rc\" || \"$IMAGE_TAG\" == \"dev\" ]] || [[ \"$SERVER_REF\" =~ ^refs/tags/v ]]; then\n  PUSH_TO_GHCR=true\nelse\n  PUSH_TO_GHCR=false\nfi\n\necho \"image_tag=$IMAGE_TAG\" >> \"$GITHUB_OUTPUT\"\necho \"server_tag=$SERVER_TAG\" >> \"$GITHUB_OUTPUT\"\necho \"web_tag=$WEB_TAG\" >> \"$GITHUB_OUTPUT\"\necho \"web_image=$WEB_IMAGE\" >> \"$GITHUB_OUTPUT\"\necho \"server_registry=$SERVER_REGISTRY\" >> \"$GITHUB_OUTPUT\"\necho \"push_to_ghcr=$PUSH_TO_GHCR\" >> \"$GITHUB_OUTPUT\"\n\necho \"Lite tag: $IMAGE_TAG\"\necho \"Server: $SERVER_REGISTRY/*:$SERVER_TAG\"\necho \"Web: $WEB_IMAGE:$WEB_TAG\"\necho \"Push to GHCR: $PUSH_TO_GHCR\"\n"
            }
          ]
        },
        "build-docker": {
          "name": "Build Docker image",
          "runs-on": "ubuntu-24.04",
          "timeout-minutes": 60,
          "needs": "setup",
          "permissions": {
            "contents": "read",
            "id-token": "write",
            "packages": "write"
          },
          "steps": [
            {
              "name": "Checkout Repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "ref": "${{ inputs.self_host_repo_ref || github.event.client_payload.self_host_repo_ref || github.ref }}",
                "persist-credentials": false,
                "allow-unsafe-pr-checkout": true
              }
            },
            {
              "name": "Check secrets",
              "id": "check-secrets",
              "env": {
                "AZURE_CLIENT_ID": "${{ secrets.AZURE_CLIENT_ID }}"
              },
              "run": "if [[ -n \"$AZURE_CLIENT_ID\" ]]; then\n  echo \"has_secrets=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"has_secrets=false\" >> \"$GITHUB_OUTPUT\"\nfi\n"
            },
            {
              "name": "Set up QEMU emulators",
              "uses": "docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1"
            },
            {
              "name": "Set up Docker Buildx",
              "uses": "docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069"
            },
            {
              "name": "Log in to Azure",
              "if": "steps.check-secrets.outputs.has_secrets == 'true'",
              "uses": "bitwarden/gh-actions/azure-login@main",
              "with": {
                "subscription_id": "${{ secrets.AZURE_SUBSCRIPTION_ID }}",
                "tenant_id": "${{ secrets.AZURE_TENANT_ID }}",
                "client_id": "${{ secrets.AZURE_CLIENT_ID }}"
              }
            },
            {
              "name": "Log in to ACR",
              "if": "steps.check-secrets.outputs.has_secrets == 'true'",
              "run": "az acr login -n bitwardenprod"
            },
            {
              "name": "Login to GitHub Container Registry",
              "if": "steps.check-secrets.outputs.has_secrets == 'true' && needs.setup.outputs.push_to_ghcr == 'true'",
              "uses": "docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6",
              "with": {
                "registry": "ghcr.io",
                "username": "${{ github.actor }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Determine image tags",
              "id": "image-ref",
              "env": {
                "PUSH_TO_GHCR": "${{ needs.setup.outputs.push_to_ghcr }}",
                "IMAGE_TAG": "${{ needs.setup.outputs.image_tag }}"
              },
              "run": "TAGS=\"bitwardenprod.azurecr.io/lite:${IMAGE_TAG}\"\nif [[ \"$PUSH_TO_GHCR\" == \"true\" ]]; then\n  TAGS=\"${TAGS},ghcr.io/bitwarden/lite:${IMAGE_TAG}\"\nfi\necho \"tags=${TAGS}\" >> \"$GITHUB_OUTPUT\"\necho \"acr_image=bitwardenprod.azurecr.io/lite:${IMAGE_TAG}\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Log build configuration",
              "env": {
                "IMAGE_TAGS": "${{ steps.image-ref.outputs.tags }}",
                "SERVER_REGISTRY": "${{ needs.setup.outputs.server_registry }}",
                "SERVER_TAG": "${{ needs.setup.outputs.server_tag }}",
                "WEB_IMAGE": "${{ needs.setup.outputs.web_image }}",
                "WEB_TAG": "${{ needs.setup.outputs.web_tag }}"
              },
              "run": "echo \"### Build Configuration\" >> $GITHUB_STEP_SUMMARY\necho \"- Lite: ${IMAGE_TAGS}\" >> $GITHUB_STEP_SUMMARY\necho \"- Server: ${SERVER_REGISTRY}/*:${SERVER_TAG}\" >> $GITHUB_STEP_SUMMARY\necho \"- Web: ${WEB_IMAGE}:${WEB_TAG}\" >> $GITHUB_STEP_SUMMARY\n"
            },
            {
              "name": "Check if image tag already exists",
              "env": {
                "IMAGE_TAG": "${{ needs.setup.outputs.image_tag }}",
                "GHCR_REGISTRY": "ghcr.io/bitwarden",
                "ACR_REGISTRY": "bitwardenprod.azurecr.io"
              },
              "run": "# Only check version tags (numeric), skip dev/branch tags\nif [[ \"$IMAGE_TAG\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"Checking if version tag ${IMAGE_TAG} already exists...\"\n\n  # Check GHCR\n  # Guard against `set -e`: a missing tag makes skopeo exit non-zero,\n  # which would abort the step on the assignment before we can inspect $status.\n  output=$(skopeo inspect \"docker://${GHCR_REGISTRY}/lite:${IMAGE_TAG}\" 2>&1) && status=0 || status=$?\n  if [[ $status -eq 0 ]]; then\n    echo \"::error::❌ Tag ${IMAGE_TAG} already exists at ${GHCR_REGISTRY}/lite:${IMAGE_TAG}\"\n    echo \"::error::Refusing to overwrite existing production image.\"\n    echo \"::error::If you need to rebuild this version, delete the existing tag first.\"\n    exit 1\n  elif echo \"$output\" | grep -qiE 'manifest unknown|not found|name unknown'; then\n    echo \"✅ GHCR tag ${IMAGE_TAG} is available\"\n  else\n    echo \"::error::Could not verify GHCR tag existence (skopeo failed): $output\"\n    exit 1\n  fi\n\n  # Check ACR\n  output=$(skopeo inspect \"docker://${ACR_REGISTRY}/lite:${IMAGE_TAG}\" 2>&1) && status=0 || status=$?\n  if [[ $status -eq 0 ]]; then\n    echo \"::error::❌ Tag ${IMAGE_TAG} already exists at ${ACR_REGISTRY}/lite:${IMAGE_TAG}\"\n    echo \"::error::Refusing to overwrite existing production image.\"\n    echo \"::error::If you need to rebuild this version, delete the existing tag first.\"\n    exit 1\n  elif echo \"$output\" | grep -qiE 'manifest unknown|not found|name unknown'; then\n    echo \"✅ ACR tag ${IMAGE_TAG} is available\"\n  else\n    echo \"::error::Could not verify ACR tag existence (skopeo failed): $output\"\n    exit 1\n  fi\n\n  echo \"✅ Tag ${IMAGE_TAG} is available on both registries\"\nelse\n  echo \"Skipping tag check for non-version tag: ${IMAGE_TAG}\"\nfi\n"
            },
            {
              "name": "Resolve built revision",
              "id": "revision",
              "run": "echo \"sha=$(git rev-parse HEAD)\" >> \"$GITHUB_OUTPUT\""
            },
            {
              "name": "Build custom image metadata",
              "id": "custom-meta",
              "env": {
                "IMAGE_TAG": "${{ needs.setup.outputs.image_tag }}",
                "REVISION": "${{ steps.revision.outputs.sha }}",
                "SERVER_REGISTRY": "${{ needs.setup.outputs.server_registry }}",
                "SERVER_TAG": "${{ needs.setup.outputs.server_tag }}",
                "WEB_IMAGE": "${{ needs.setup.outputs.web_image }}",
                "WEB_TAG": "${{ needs.setup.outputs.web_tag }}"
              },
              "run": "{\n  echo \"items<<METADATA_EOF\"\n  echo \"org.opencontainers.image.title=Bitwarden Lite\"\n  echo \"org.opencontainers.image.description=All-in-one Bitwarden self-hosted container\"\n  echo \"org.opencontainers.image.vendor=Bitwarden Inc.\"\n  echo \"org.opencontainers.image.url=https://bitwarden.com\"\n  echo \"org.opencontainers.image.source=https://github.com/bitwarden/self-host\"\n  echo \"org.opencontainers.image.version=${IMAGE_TAG}\"\n  echo \"org.opencontainers.image.revision=${REVISION}\"\n  echo \"com.bitwarden.server.registry=${SERVER_REGISTRY}\"\n  echo \"com.bitwarden.server.tag=${SERVER_TAG}\"\n  echo \"com.bitwarden.web.image=${WEB_IMAGE}\"\n  echo \"com.bitwarden.web.tag=${WEB_TAG}\"\n  echo \"METADATA_EOF\"\n} >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Generate image metadata",
              "id": "meta",
              "uses": "docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302",
              "env": {
                "DOCKER_METADATA_ANNOTATIONS_LEVELS": "index,manifest"
              },
              "with": {
                "images": "bitwardenprod.azurecr.io/lite\nghcr.io/bitwarden/lite\n",
                "labels": "${{ steps.custom-meta.outputs.items }}",
                "annotations": "${{ steps.custom-meta.outputs.items }}"
              }
            },
            {
              "name": "Build and push Docker image",
              "id": "build-docker",
              "uses": "docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc",
              "with": {
                "context": ".",
                "file": "bitwarden-lite/Dockerfile",
                "platforms": "linux/amd64,\nlinux/arm/v7,\nlinux/arm64/v8\n",
                "push": "${{ steps.check-secrets.outputs.has_secrets == 'true' }}",
                "tags": "${{ steps.image-ref.outputs.tags }}",
                "labels": "${{ steps.meta.outputs.labels }}",
                "annotations": "${{ steps.meta.outputs.annotations }}",
                "build-args": "SERVER_TAG=${{ needs.setup.outputs.server_tag }}\nSERVER_REGISTRY=${{ needs.setup.outputs.server_registry }}\nWEB_IMAGE=${{ needs.setup.outputs.web_image }}\nWEB_TAG=${{ needs.setup.outputs.web_tag }}\n"
              }
            },
            {
              "name": "Install Cosign",
              "if": "steps.check-secrets.outputs.has_secrets == 'true'",
              "uses": "sigstore/cosign-installer@6f9f17788090df1f26f669e9d70d6ae9567deba6"
            },
            {
              "name": "Sign image with Cosign",
              "if": "steps.check-secrets.outputs.has_secrets == 'true'",
              "env": {
                "DIGEST": "${{ steps.build-docker.outputs.digest }}",
                "PUSH_TO_GHCR": "${{ needs.setup.outputs.push_to_ghcr }}",
                "ACR_IMAGE": "${{ steps.image-ref.outputs.acr_image }}",
                "GHCR_IMAGE": "ghcr.io/bitwarden/lite:${{ needs.setup.outputs.image_tag }}"
              },
              "run": "cosign sign --yes \"${ACR_IMAGE}@${DIGEST}\"\nif [[ \"$PUSH_TO_GHCR\" == \"true\" ]]; then\n  cosign sign --yes \"${GHCR_IMAGE}@${DIGEST}\"\nfi\n"
            },
            {
              "name": "Log out of registries",
              "if": "always()",
              "run": "docker logout ghcr.io || true\naz acr logout -n bitwardenprod || true\n"
            }
          ]
        }
