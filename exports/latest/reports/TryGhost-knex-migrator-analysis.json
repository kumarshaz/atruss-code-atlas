    {
      "id": "publish.yml",
      "path": ".github/workflows/publish.yml",
      "name": "Publish",
      "triggers": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": {
        "publish": {
          "name": "Publish to npm",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "id-token": "write",
            "contents": "read"
          },
          "env": {
            "FORCE_COLOR": 1,
            "CI": true,
            "NPM_CONFIG_PROVENANCE": true,
            "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org"
          },
          "steps": [
            {
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "persist-credentials": false
              }
            },
            {
              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "with": {
                "node-version": "24.14.1",
                "registry-url": "https://registry.npmjs.org"
              }
            },
            {
              "name": "Install Corepack",
              "run": "npm install --global corepack@0.34.6"
            },
            {
              "name": "Enable corepack",
              "run": "corepack enable"
            },
            {
              "name": "Install dependencies",
              "run": "pnpm install --frozen-lockfile --prefer-offline"
            },
            {
              "name": "Determine whether to publish",
              "id": "pub",
              "run": "name=$(jq -r .name package.json)\nversion=$(jq -r .version package.json)\nif [ -n \"$(npm view \"$name@$version\" version 2>/dev/null)\" ]; then\n  echo \"$name@$version is already published; nothing to do\"\n  echo \"publish=false\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"queueing $name@$version\"\n  echo \"publish=true\" >> \"$GITHUB_OUTPUT\"\nfi\n"
            },
            {
              "name": "Publish to npm",
              "if": "steps.pub.outputs.publish == 'true'",
              "run": "pnpm publish --no-git-checks ${{ (github.event.inputs['dry-run'] == 'true' && '--dry-run') || '' }}"
            }
          ]
        }
      },
