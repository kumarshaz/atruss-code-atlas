  "pipelines": [
    {
      "id": "validate-skills.yml",
      "path": ".github/workflows/validate-skills.yml",
      "name": "Validate Skills",
      "triggers": [
        "pull_request",
        "push"
      ],
      "jobs": {
        "skill-standards": {
          "name": "Skill Standards",
          "runs-on": "${{ matrix.os }}",
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "os": [
                "ubuntu-latest",
                "macos-latest"
              ]
            }
          },
          "steps": [
            {
              "uses": "actions/checkout@v4"
            },
            {
              "uses": "actions/setup-python@v5",
              "with": {
                "python-version": "3.12"
              }
            },
            {
              "name": "Validate skill frontmatter and structure",
              "run": "scripts/validate-skills.sh"
            },
            {
              "name": "Check generated files are up to date",
              "run": "python3 scripts/generate_catalog.py --check"
            },
            {
              "name": "Check links and path mentions",
              "run": "python3 scripts/check_links.py"
            },
            {
              "name": "Run tests",
              "run": "python3 -m unittest discover -s tests -v"
            }
          ]
        },
        "plugin-install": {
          "name": "Plugin Install",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "uses": "actions/checkout@v4"
            },
            {
              "uses": "actions/setup-python@v5",
              "with": {
                "python-version": "3.12"
              }
            },
            {
              "uses": "actions/setup-node@v4",
              "with": {
                "node-version": "24"
              }
            },
            {
              "name": "Skills CLI discovery",
              "run": "npx -y skills@1.7.2 add . --list < /dev/null > \"$RUNNER_TEMP/skills-list.txt\" 2>&1 || {\n  cat \"$RUNNER_TEMP/skills-list.txt\"\n  exit 1\n}\npython3 -I - \"$RUNNER_TEMP/skills-list.txt\" <<'PY'\nimport re\nimport sys\nfrom pathlib import Path\n\ntext = re.sub(r\"\\x1b\\[[0-9;?]*[A-Za-z]\", \"\", Path(sys.argv[1]).read_text(encoding=\"utf-8\"))\nfound = [int(n) for n in re.findall(r\"Found (\\d+) skills?\", text)]\nlisted = re.findall(r\"^│ {4}(\\S+)\\s*$\", text, re.M)\non_disk = sorted(p.parent.name for p in Path(\"skills\").glob(\"*/*/SKILL.md\"))\n\nproblems = []\nif found != [len(on_disk)]:\n    problems.append(f\"CLI reported {found} skills, {len(on_disk)} SKILL.md files on disk\")\nif sorted(listed) != on_disk:\n    problems.append(\n        f\"missing from CLI listing: {sorted(set(on_disk) - set(listed))}; \"\n        f\"unexpected in CLI listing: {sorted(set(listed) - set(on_disk))}; \"\n        f\"listed {len(listed)} names\"\n    )\nif problems:\n    print(text)\n    sys.exit(\"skills CLI discovery mismatch: \" + \"; \".join(problems))\nprint(f\"skills CLI found {found[0]} skills, matching skills/*/*/SKILL.md\")\nPY\n"
            },
            {
              "name": "Install Claude Code CLI",
              "run": "npm install --prefix \"$RUNNER_TEMP/claude-cli\" --no-audit --no-fund @anthropic-ai/claude-code@2.1.299\necho \"$RUNNER_TEMP/claude-cli/node_modules/.bin\" >> \"$GITHUB_PATH\"\n"
            },
            {
              "name": "Isolate Claude Code state",
              "run": "mkdir -p \"$RUNNER_TEMP/claude-home\" \"$RUNNER_TEMP/claude-config\"\necho \"HOME=$RUNNER_TEMP/claude-home\" >> \"$GITHUB_ENV\"\necho \"CLAUDE_CONFIG_DIR=$RUNNER_TEMP/claude-config\" >> \"$GITHUB_ENV\"\n"
            },
            {
              "name": "Validate plugin marketplace",
              "run": "claude plugin validate . --strict --json < /dev/null > \"$RUNNER_TEMP/plugin-validate.json\" || {\n  cat \"$RUNNER_TEMP/plugin-validate.json\"\n  exit 1\n}\npython3 -I - \"$RUNNER_TEMP/plugin-validate.json\" <<'PY'\nimport json\nimport sys\n\nwith open(sys.argv[1], encoding=\"utf-8\") as f:\n    result = json.load(f)\nmanifest = result.get(\"manifest\") or {}\ncontents = result.get(\"contents\") or []\ndirty_contents = [c for c in contents if c.get(\"errors\") or c.get(\"warnings\")]\nif (\n    result.get(\"success\") is not True\n    or manifest.get(\"errors\")\n    or manifest.get(\"warnings\")\n    or dirty_contents\n):\n    print(json.dumps(result, indent=2))\n    sys.exit(\"claude plugin validate did not come back clean\")\nprint(\"claude plugin validate: success, no errors or warnings:\", manifest.get(\"file\"))\nPY\n"
            },
            {
              "name": "Install every plugin from this checkout",
              "run": "marketplace=\"$(python3 -I -c 'import json; print(json.load(open(\".claude-plugin/marketplace.json\"))[\"name\"])')\"\nplugins=\"$(python3 -I -c 'import json; print(\"\\n\".join(p[\"name\"] for p in json.load(open(\".claude-plugin/marketplace.json\"))[\"plugins\"]))')\"\nclaude plugin marketplace add \"$GITHUB_WORKSPACE\" --json < /dev/null\nwhile IFS= read -r plugin; do\n  claude plugin install \"$plugin@$marketplace\" --json < /dev/null\ndone <<< \"$plugins\"\nclaude plugin list --json < /dev/null > \"$RUNNER_TEMP/installed.json\"\npython3 scripts/generate_catalog.py --list-categories > \"$RUNNER_TEMP/category-counts.txt\"\npython3 -I - \"$RUNNER_TEMP/installed.json\" \"$marketplace\" \"$RUNNER_TEMP/category-counts.txt\" <<'PY'\nimport json\nimport os\nimport sys\nfrom pathlib import Path\n\ninstalled_file, marketplace, counts_file = sys.argv[1:4]\nwith open(installed_file, encoding=\"utf-8\") as f:\n    installed = {p[\"id\"]: p for p in json.load(f)}\nwith open(\".claude-plugin/marketplace.json\", encoding=\"utf-8\") as f:\n    entries = {p[\"name\"]: p for p in json.load(f)[\"plugins\"]}\nconfig_dir = os.path.realpath(os.environ[\"CLAUDE_CONFIG_DIR\"])\n\n# Expected skill count per plugin, from the catalog (\"<dir>\\t<plugin>\\t<n>\" per line).\nexpected_counts = {}\nwith open(counts_file, encoding=\"utf-8\") as f:\n    for line in f:\n        line = line.rstrip(\"\\n\")\n        if not line:\n            continue\n        _dir, plugin_name, n = line.split(\"\\t\")\n        expected_counts[plugin_name] = int(n)\n\ntotal_expected = sum(expected_counts.values())\non_disk = len(list(Path(\"skills\").glob(\"*/*/SKILL.md\")))\nif total_expected != on_disk:\n    sys.exit(f\"category counts total to {total_expected}, but {on_disk} SKILL.md files on disk\")\n\n# Shared files every plugin's install root carries, since the whole repo is\n# copied for each plugin install.\nshared_files = (\n    \"references/fme/tool-map.md\",\n    \"references/scope-establishment.md\",\n    \"templates/operation-summary.md\",\n)\n\nproblems = []\nfor name, entry in entries.items():\n    plugin = installed.get(f\"{name}@{marketplace}\")\n    if plugin is None or not plugin.get(\"enabled\"):\n        problems.append(f\"{name}: not installed and enabled\")\n        continue\n    root = Path(plugin[\"installPath\"])\n    if not os.path.realpath(root).startswith(config_dir + os.sep):\n        problems.append(f\"{name}: installed at {root}, not copied under {config_dir}\")\n        continue\n    # Skills the installed copy exposes, from the entry's own skills paths.\n    count = sum(\n        1\n        for rel in entry.get(\"skills\", [])\n        for skill in (root / rel).iterdir()\n        if (skill / \"SKILL.md\").is_file()\n    )\n    print(f\"{name}: {root} ({count} skills)\")\n    expected = expected_counts.get(name)\n    if expected is None:\n        problems.append(f\"{name}: no expected skill count in category list\")\n    elif count != expected:\n        problems.append(f\"{name} exposes {count} skills, expected {expected}\")\n    for rel in shared_files:\n        if not (root / rel).is_file():\n            problems.append(f\"{name} install is missing {rel}\")\nif problems:\n    sys.exit(\"install smoke test failed:\\n  \" + \"\\n  \".join(problems))\nprint(f\"installed {len(entries)} plugins from {marketplace}\")\nPY\n"
            }
