      "path": ".github/workflows/spellcheck.yaml",
      "name": "Codespell",
      "triggers": [
        "pull_request"
      ],
      "jobs": {
        "codespell": {
          "name": "Codespell",
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Checkout Code",
              "uses": "actions/checkout@v7.0.1"
            },
            {
              "name": "Codespell",
              "uses": "codespell-project/actions-codespell@v2",
              "with": {
                "skip": ".git",
                "check_filenames": true,
                "check_hidden": true
              }
            }
          ]
