      "id": "release.yml",
      "path": ".github/workflows/release.yml",
      "name": "Release Charts",
      "triggers": [
        "push"
      ],
      "jobs": {
        "release": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "packages": "write",
            "id-token": "write"
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "fetch-depth": 0
              }
            },
            {
              "name": "Configure Git",
              "run": "git config user.name \"$GITHUB_ACTOR\"\ngit config user.email \"$GITHUB_ACTOR@users.noreply.github.com\"\n"
            },
            {
              "name": "Run chart-releaser",
              "uses": "helm/chart-releaser-action@92c6b97fa9f664492a2592e0d1d80bc6bf378957",
              "with": {
                "config": "cr.yaml"
              },
              "env": {
                "CR_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Login to GitHub Container Registry",
              "uses": "docker/login-action@8aa5831fb8d48d8f76594c7ddde61ae58019f550",
              "with": {
                "registry": "ghcr.io",
                "username": "${{ github.actor }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Install Cosign",
              "uses": "sigstore/cosign-installer@756fe2d284c7292c4e9b62c8a28f1e5629c59532"
            },
            {
              "name": "Install Oras",
              "uses": "oras-project/setup-oras@5e2f2482b30b0cb3e14e67f89a80c88c659a7c63"
            },
            {
              "name": "Publish and Sign OCI Charts",
              "run": "for chart in `find .cr-release-packages -name '*.tgz' -print`; do\n  helm push ${chart} oci://ghcr.io/${GITHUB_REPOSITORY} |& tee helm-push-output.log\n  file_name=${chart##*/}\n  chart_name=${file_name%-*}\n  digest=$(awk -F \"[, ]+\" '/Digest/{print $NF}' < helm-push-output.log)\n  cosign sign -y \"ghcr.io/${GITHUB_REPOSITORY}/${chart_name}@${digest}\"\n\n  oras push \"ghcr.io/${GITHUB_REPOSITORY}/${chart_name}:artifacthub.io\" \"./charts/${chart_name}/artifacthub-repo.yml:application/vnd.cncf.artifacthub.repository-metadata.layer.v1.yaml\"\ndone\n",
              "env": {
                "COSIGN_EXPERIMENTAL": 1
              }
            }
          ]
        }
      },
