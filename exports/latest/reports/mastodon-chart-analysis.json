  "pipelines": [
    {
      "id": "test-chart.yml",
      "path": ".github/workflows/test-chart.yml",
      "name": "Test chart",
      "triggers": [
        "pull_request",
        "push",
        "workflow_dispatch"
      ],
      "jobs": {
        "lint-templates": {
          "runs-on": "ubuntu-24.04",
          "steps": [
            {
              "uses": "actions/checkout@v3"
            },
            {
              "uses": "actions/setup-python@v4",
              "with": {
                "python-version": "3.x"
              }
            },
            {
              "name": "Install dependencies (yamllint)",
              "run": "pip install yamllint"
            },
            {
              "run": "helm dependency update"
            },
            {
              "name": "helm lint",
              "run": "helm lint . \\\n    --values dev-values.yaml\n"
            },
            {
              "name": "helm template",
              "run": "helm template . \\\n    --values dev-values.yaml \\\n    --output-dir rendered-templates\n"
            },
            {
              "name": "yamllint (only on templates we manage)",
              "run": "rm -rf rendered-templates/mastodon/charts\n\nyamllint rendered-templates \\\n  --config-data \"{rules: {indentation: {spaces: 2}, line-length: disable}}\"\n"
            }
          ]
        },
        "test-install": {
          "runs-on": "ubuntu-24.04",
          "timeout-minutes": 15,
          "strategy": {
            "fail-fast": false,
            "matrix": {
              "include": [
                {
                  "k3s-channel": "latest"
                },
                {
                  "k3s-channel": "stable"
                },
                {
                  "k3s-channel": "v1.33",
                  "helm-version": "v3.19.0"
                }
              ]
            }
          },
          "env": {
            "HELM_EXPERIMENTAL_OCI": "1"
          },
          "steps": [
            {
              "uses": "actions/checkout@v5"
            },
            {
              "uses": "jupyterhub/action-k3s-helm@v4",
              "with": {
                "k3s-channel": "${{ matrix.k3s-channel }}",
                "helm-version": "${{ matrix.helm-version }}",
                "metrics-enabled": false,
                "traefik-enabled": false,
                "docker-enabled": false
              }
            },
            {
              "run": "helm dependency update"
            },
            {
              "name": "helm template --validate",
              "run": "helm template --validate mastodon . \\\n    --values dev-values.yaml\n"
            },
            {
              "name": "helm install",
              "run": "helm install mastodon . \\\n    --values dev-values.yaml \\\n    --timeout 15m\n"
            },
            {
              "name": "Kubernetes namespace report",
              "uses": "jupyterhub/action-k8s-namespace-report@v1",
              "if": "always()",
              "with": {
                "important-workloads": "deploy/mastodon-sidekiq deploy/mastodon-streaming deploy/mastodon-web job/mastodon-create-admin job/mastodon-db-migrate"
              }
            }
          ]
        }
      },
