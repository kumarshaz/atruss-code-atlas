            "context": "server",
            "dockerfile": "server/Dockerfile",
            "target": "${{ matrix.target }}",
            "tags": "type=ref,event=branch\ntype=ref,event=pr\ntype=sha,format=long,prefix=commit-\ntype=ref,event=tag\n"
          }
