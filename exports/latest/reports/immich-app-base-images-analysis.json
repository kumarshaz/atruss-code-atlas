  "pipelines": [
    {
      "id": "build-postgres.yml",
      "path": ".github/workflows/build-postgres.yml",
      "name": "Build and Push Postgres Images",
      "triggers": [
        "workflow_dispatch",
        "push",
        "pull_request"
      ],
      "jobs": {
        "pre-job": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "read"
          },
          "outputs": {
            "should_run": "${{ steps.check.outputs.should_run }}"
          },
          "steps": [
            {
              "name": "Check what should run",
              "id": "check",
              "uses": "immich-app/devtools/actions/pre-job@75493d49052d536863fc96100086782c5279b145",
              "with": {
                "github-token": "${{ github.token }}",
                "filters": "postgres:\n  - 'postgres/**'\n",
                "force-filters": "- '.github/workflows/build-postgres.yml'\n"
              }
            }
          ]
        },
        "matrix": {
          "runs-on": "ubuntu-latest",
          "needs": "pre-job",
          "if": "${{ fromJSON(needs.pre-job.outputs.should_run).postgres == true }}",
          "permissions": {
            "contents": "read"
          },
          "outputs": {
            "matrix": "${{ steps.get-versions.outputs.result }}"
          },
          "steps": [
            {
              "name": "Checkout to repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
            },
            {
              "id": "get-versions",
              "name": "Get dependency versions",
              "uses": "mikefarah/yq@f2944b823f84906a127dbd29e4c2a3e60c4e550e",
              "with": {
                "cmd": "yq eval -o=json -I=0 postgres/versions.yaml"
              }
            }
          ]
        },
        "build_and_push": {
          "runs-on": "ubuntu-latest",
          "needs": [
            "pre-job",
            "matrix"
          ],
          "if": "${{ fromJSON(needs.pre-job.outputs.should_run).postgres == true }}",
          "strategy": {
            "fail-fast": false,
            "matrix": "${{ fromJson(needs.matrix.outputs.matrix) }}"
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "fetch-depth": 0
              }
            },
            {
              "name": "Set up QEMU",
              "uses": "docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1"
            },
            {
              "name": "Set up Docker Buildx",
              "uses": "docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069"
            },
            {
              "name": "Login to GitHub Container Registry",
              "uses": "docker/login-action@8aa5831fb8d48d8f76594c7ddde61ae58019f550",
              "if": "${{ !github.event.pull_request.head.repo.fork }}",
              "with": {
                "registry": "ghcr.io",
                "username": "${{ github.repository_owner }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Determine version change",
              "id": "changed-version",
              "env": {
                "BASE": "${{ github.event_name == 'pull_request' && format('origin/{0}', github.base_ref) || 'HEAD~1' }}"
              },
              "run": "CHANGED_FILES=$(git diff --name-only $BASE...HEAD)\necho $CHANGED_FILES\nif echo \"$CHANGED_FILES\" | grep -q -e \"^postgres/\" -e \"^.github/workflows/build-postgres.yml$\"; then\n  echo \"any_changed=true\" >> $GITHUB_OUTPUT\nelse\n  echo \"any_changed=false\" >> $GITHUB_OUTPUT\nfi\n"
            },
            {
              "name": "Determine image push",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "id": "should-release",
              "with": {
                "script": "if (context.eventName == \"pull_request\") return false;\nif (context.eventName == \"workflow_dispatch\") return true;\nreturn \"${{ steps.changed-version.outputs.any_changed }}\" == \"true\";\n"
              }
            },
            {
              "name": "Determine latest version of VectorChord in matrix",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "id": "latest-vchord",
              "env": {
                "VERSION_MATRIX": "${{ needs.matrix.outputs.matrix }}"
              },
              "with": {
                "script": "const versions = JSON.parse(process.env.VERSION_MATRIX).vectorchord;\nconst latest = versions.sort()[versions.length - 1];\nconsole.log(`Latest VectorChord version: ${latest}`);\nreturn latest;\n"
              }
            },
            {
              "name": "Determine latest version of pgvector in matrix",
              "uses": "actions/github-script@3a2844b7e9c422d3c10d287c895573f7108da1b3",
              "id": "latest-pgvector",
              "env": {
                "VERSION_MATRIX": "${{ needs.matrix.outputs.matrix }}"
              },
              "with": {
                "script": "const versions = JSON.parse(process.env.VERSION_MATRIX).pgvector;\nconst latest = versions.sort()[versions.length - 1];\nconsole.log(`Latest pgvector version: ${latest}`);\nreturn latest;\n"
              }
            },
            {
              "name": "Generate docker image tags",
              "id": "metadata",
              "uses": "docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302",
              "with": {
                "flavor": "# Disable latest tag\nlatest=false\n",
                "images": "name=ghcr.io/${{ github.repository_owner }}/postgres\n",
                "tags": "type=raw,value=${{ matrix.pg }}-vectorchord${{ matrix.vectorchord }}-pgvector${{ matrix.pgvector }}-pgvectors${{ matrix.pgvectors }},enable=${{ matrix.pgvectors != '' }}\ntype=raw,value=${{ matrix.pg }}-vectorchord${{ matrix.vectorchord }}-pgvectors${{ matrix.pgvectors }},enable=${{matrix.pgvectors != '' && matrix.pgvector == fromJson(steps.latest-pgvector.outputs.result) }}\ntype=raw,value=${{ matrix.pg }}-vectorchord${{ matrix.vectorchord }}-pgvector${{ matrix.pgvector }},enable=${{ matrix.pgvectors == '' }}\ntype=raw,value=${{ matrix.pg }}-vectorchord${{ matrix.vectorchord }},enable=${{ matrix.pgvectors == '' && matrix.pgvector == fromJson(steps.latest-pgvector.outputs.result) }}\n"
              }
            },
            {
              "name": "Build and push image",
              "uses": "docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc",
              "with": {
                "context": "postgres/",
                "platforms": "linux/amd64,linux/arm64",
                "push": "${{ steps.should-release.outputs.result }}",
                "cache-from": "type=gha",
                "cache-to": "type=gha,mode=max",
                "tags": "${{ steps.metadata.outputs.tags }}",
                "labels": "${{ steps.metadata.outputs.labels }}",
                "build-args": "PG_MAJOR=${{ matrix.pg }}\nVECTORCHORD_TAG=${{ matrix.vectorchord }}\nPGVECTORS_TAG=${{ matrix.pgvectors }}\nPGVECTOR_TAG=${{ matrix.pgvector }}\n"
              }
            }
          ]
        },
        "results": {
          "if": "${{ always() }}",
          "runs-on": "ubuntu-latest",
          "name": "Postgres build success",
          "needs": [
            "build_and_push"
          ],
          "steps": [
            {
              "run": "result=\"${{ needs.build_and_push.result }}\"\nif [[ $result == \"success\" || $result == \"skipped\" ]]; then\n  exit 0\nelse\n  exit 1\nfi\n"
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "pre-job",
          "name": "pre-job",
          "runner": "ubuntu-latest",
          "steps_count": 1,
          "needs": [],
          "environment": null
        },
        {
          "id": "matrix",
          "name": "matrix",
          "runner": "ubuntu-latest",
          "steps_count": 2,
          "needs": [
            "pre-job"
          ],
          "environment": null
        },
        {
          "id": "build_and_push",
          "name": "build_and_push",
          "runner": "ubuntu-latest",
          "steps_count": 10,
          "needs": [
            "pre-job",
            "matrix"
          ],
          "environment": null
        },
        {
          "id": "results",
          "name": "Postgres build success",
          "runner": "ubuntu-latest",
          "steps_count": 1,
          "needs": [
            "build_and_push"
          ],
          "environment": null
