    {
      "id": "build-test.yml",
      "path": ".github/workflows/build-test.yml",
      "name": "build-test",
      "triggers": [
        "push",
        "pull_request"
      ],
      "jobs": {
        "gen-matrix": {
          "name": "generate-matrix",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "read",
            "pull-requests": "read"
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
            },
            {
              "name": "Calculate file differences",
              "id": "diff",
              "uses": "step-security/changed-files@3dbe17c78367e7d60f00d78ae6781a35be47b4a1",
              "with": {
                "json": true,
                "escape_json": false
              }
            },
            {
              "name": "Generate testing matrix",
              "uses": "actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd",
              "id": "generator",
              "with": {
                "github-token": "${{ secrets.GITHUB_TOKEN }}",
                "script": "const script = require(`${process.env.GITHUB_WORKSPACE}/genMatrix.js`)\nreturn script(\n  ${{ steps.diff.outputs.added_files }},\n  ${{ steps.diff.outputs.modified_files }},\n  ${{ steps.diff.outputs.renamed_files }},\n);\n"
              }
            }
          ],
          "outputs": {
            "matrix": "${{ steps.generator.outputs.result }}"
          }
        },
        "build": {
          "if": "${{ fromJson(needs.gen-matrix.outputs.matrix) }}",
          "needs": "gen-matrix",
          "name": "build",
          "runs-on": "ubuntu-latest",
          "timeout-minutes": 60,
          "permissions": {
            "contents": "read"
          },
          "strategy": {
            "fail-fast": false,
            "matrix": "${{ fromJson(needs.gen-matrix.outputs.matrix) }}"
          },
          "steps": [
            {
              "name": "Get short node version",
              "uses": "actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd",
              "id": "short-version",
              "with": {
                "result-encoding": "string",
                "script": "const version = \"${{ matrix.version }}\".split('.');\nreturn `${version[0]}.${version[1]}`\n"
              }
            },
            {
              "name": "Checkout",
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
            },
            {
              "name": "Build image",
              "uses": "docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8",
              "with": {
                "push": false,
                "load": true,
                "context": ".",
                "file": "./${{ steps.short-version.outputs.result }}/Dockerfile",
                "tags": "rocket.chat:${{ matrix.version }}"
              }
            },
            {
              "name": "Run Image",
              "env": {
                "IMAGE": "rocket.chat",
                "RELEASE": "${{ matrix.version }}",
                "DEPRECATED_COMPOSE_ACK": "true"
              },
              "run": "docker compose up -d"
            },
            {
              "name": "Wait for Rocket.Chat to start up",
              "uses": "cygnetdigital/wait_for_response@510ed9823ee9c5f876e57d25bd87c575032d8156",
              "with": {
                "url": "http://localhost:3000/health",
                "responseCode": "200",
                "timeout": 60000,
                "interval": 1000
              }
            },
            {
              "name": "Show logs if failed",
              "if": "failure()",
              "env": {
                "DEPRECATED_COMPOSE_ACK": "true"
              },
              "run": "docker compose logs"
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "gen-matrix",
          "name": "generate-matrix",
          "runner": "ubuntu-latest",
          "steps_count": 3,
          "needs": [],
          "environment": null
        },
        {
          "id": "build",
          "name": "build",
          "runner": "ubuntu-latest",
          "steps_count": 6,
          "needs": [
            "gen-matrix"
          ],
          "environment": null
