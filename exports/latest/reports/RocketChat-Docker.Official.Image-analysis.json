      "id": "automatic-updates.yml",
      "path": ".github/workflows/automatic-updates.yml",
      "name": "Automatically update Docker image versions",
      "triggers": [
        "schedule"
      ],
      "jobs": {
        "build": {
          "runs-on": "ubuntu-latest",
          "if": "github.repository_owner == 'rocketchat'",
          "permissions": {
            "contents": "read"
          },
          "steps": [
            {
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd"
            },
            {
              "name": "Run automation script",
              "uses": "actions/github-script@ed597411d8f924073f98dfc5c65a23a2325f34cd",
              "id": "updt",
              "with": {
                "result-encoding": "string",
                "script": "const { default: script } = await import(`${process.env.GITHUB_WORKSPACE}/build-automation.mjs`);\nreturn script(github);\n"
              }
            },
            {
              "name": "Create update PR",
              "id": "cpr",
              "uses": "peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1",
              "with": {
                "token": "${{ secrets.GH_API_TOKEN }}",
                "author": "rocketchat-github-ci <buildmaster@rocket.chat>",
                "branch": "update-branch",
                "base": "main",
                "commit-message": "feat: Rocket.Chat ${{ steps.updt.outputs.result }}",
                "title": "feat: Rocket.Chat ${{ steps.updt.outputs.result }}",
                "delete-branch": true,
                "reviewers": "sampaiodiego\n"
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "build",
          "name": "build",
          "runner": "ubuntu-latest",
          "steps_count": 3,
          "needs": [],
          "environment": null
        }
