    {
      "id": "update-langfuse-version.yml",
      "path": ".github/workflows/update-langfuse-version.yml",
      "name": "Update Langfuse Version",
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "jobs": {
        "check-and-update": {
          "name": "Check and update Langfuse version",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "pull-requests": "write"
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "token": "${{ secrets.GITHUB_TOKEN }}",
                "persist-credentials": false
              }
            },
            {
              "name": "Get current Langfuse version",
              "id": "current-version",
              "run": "CURRENT_VERSION=$(grep 'appVersion:' charts/langfuse/Chart.yaml | cut -d '\"' -f 2)\necho \"current=$CURRENT_VERSION\" >> \"$GITHUB_OUTPUT\"\necho \"Current Langfuse version: $CURRENT_VERSION\"\n"
            },
            {
              "name": "Get latest Langfuse release",
              "id": "latest-version",
              "run": "LATEST_VERSION=$(curl -s https://api.github.com/repos/langfuse/langfuse/releases/latest | jq -r '.tag_name | ltrimstr(\"v\")')\necho \"latest=$LATEST_VERSION\" >> \"$GITHUB_OUTPUT\"\necho \"Latest Langfuse version: $LATEST_VERSION\"\n"
            },
            {
              "name": "Compare versions",
              "id": "version-check",
              "run": "if [ \"$CURRENT_VERSION\" != \"$LATEST_VERSION\" ]; then\n  echo \"needs_update=true\" >> \"$GITHUB_OUTPUT\"\n  echo \"New version available: $LATEST_VERSION\"\nelse\n  echo \"needs_update=false\" >> \"$GITHUB_OUTPUT\"\n  echo \"Already up to date\"\nfi\n",
              "env": {
                "CURRENT_VERSION": "${{ steps.current-version.outputs.current }}",
                "LATEST_VERSION": "${{ steps.latest-version.outputs.latest }}"
              }
            },
            {
              "name": "Update Chart.yaml",
              "if": "steps.version-check.outputs.needs_update == 'true'",
              "id": "update-chart",
              "run": "# Get current chart version\nCURRENT_CHART_VERSION=$(grep '^version:' charts/langfuse/Chart.yaml | cut -d ' ' -f 2)\necho \"Current chart version: $CURRENT_CHART_VERSION\"\n\n# Increment patch version\nif [[ ! \"$CURRENT_CHART_VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]]; then\n  echo \"Unsupported chart version format: $CURRENT_CHART_VERSION\" >&2\n  exit 1\nfi\n\nIFS='.' read -r MAJOR MINOR PATCH <<< \"$CURRENT_CHART_VERSION\"\nNEW_CHART_VERSION=\"${MAJOR}.${MINOR}.$((PATCH + 1))\"\necho \"New chart version: $NEW_CHART_VERSION\"\n\n# Update Chart.yaml\nsed -i \"s/^version: .*/version: $NEW_CHART_VERSION/\" charts/langfuse/Chart.yaml\nsed -i \"s/^appVersion: .*/appVersion: \\\"$LATEST_VERSION\\\"/\" charts/langfuse/Chart.yaml\n\necho \"chart_version=$NEW_CHART_VERSION\" >> \"$GITHUB_OUTPUT\"\n",
              "env": {
                "LATEST_VERSION": "${{ steps.latest-version.outputs.latest }}"
              }
            },
            {
              "name": "Install helm-docs",
              "if": "steps.version-check.outputs.needs_update == 'true'",
              "run": "cd /tmp\ncurl -L https://github.com/norwoodj/helm-docs/releases/download/v1.14.2/helm-docs_1.14.2_Linux_x86_64.tar.gz | tar xz\nsudo mv helm-docs /usr/local/bin/\n"
            },
            {
              "name": "Update README.md",
              "if": "steps.version-check.outputs.needs_update == 'true'",
              "run": "cd charts/langfuse\nhelm-docs\n"
            },
            {
              "name": "Create Pull Request",
              "if": "steps.version-check.outputs.needs_update == 'true'",
              "uses": "peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1",
              "with": {
                "token": "${{ secrets.GITHUB_TOKEN }}",
                "commit-message": "chore: bump langfuse to ${{ steps.latest-version.outputs.latest }}\n\n- Update appVersion to ${{ steps.latest-version.outputs.latest }}\n- Bump chart version to ${{ steps.update-chart.outputs.chart_version }}\n- Update generated documentation\n",
                "title": "chore: bump langfuse to ${{ steps.latest-version.outputs.latest }}",
                "body": "## Summary\nThis PR updates Langfuse to version ${{ steps.latest-version.outputs.latest }}.\n\n## Changes\n- ⬆️ Update appVersion from ${{ steps.current-version.outputs.current }} to ${{ steps.latest-version.outputs.latest }}\n- 📦 Bump chart version to ${{ steps.update-chart.outputs.chart_version }}\n- 📝 Update generated documentation\n\n## Automated Changes\nThis PR was automatically created by the weekly version check workflow.\n\n---\n**Release Notes**: https://github.com/langfuse/langfuse/releases/tag/v${{ steps.latest-version.outputs.latest }}\n",
                "branch": "update-langfuse-${{ steps.latest-version.outputs.latest }}",
                "delete-branch": true,
                "labels": "automated\ndependencies\nlangfuse-update\n"
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "check-and-update",
          "name": "Check and update Langfuse version",
          "runner": "ubuntu-latest",
          "steps_count": 8,
          "needs": [],
          "environment": null
        }
