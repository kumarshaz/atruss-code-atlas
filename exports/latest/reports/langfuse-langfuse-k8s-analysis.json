      "id": "release.yaml",
      "path": ".github/workflows/release.yaml",
      "name": "Release Charts",
      "triggers": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": {
        "release": {
          "name": "Release Helm Chart",
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "packages": "write"
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1",
              "with": {
                "fetch-depth": 0,
                "persist-credentials": false
              }
            },
            {
              "name": "Configure Git",
              "run": "git config user.name \"$GITHUB_ACTOR\"\ngit config user.email \"$GITHUB_ACTOR@users.noreply.github.com\"\n"
            },
            {
              "name": "Install Helm",
              "uses": "azure/setup-helm@9bc31f4ebc9c6b171d7bfbaa5d006ae7abdb4310"
            },
            {
              "name": "Add chart dependency repositories",
              "run": "helm repo add groundhog2k https://groundhog2k.github.io/helm-charts/\nhelm repo add valkey https://valkey-io.github.io/valkey-helm\nhelm repo add seaweedfs https://seaweedfs.github.io/seaweedfs/helm\n"
            },
            {
              "name": "Update dependencies",
              "run": "helm dependency update charts/langfuse/"
            },
            {
              "name": "Set Chart Version",
              "id": "chart-version",
              "run": "# Extract chart version from the Chart.yaml\nCHART_DIR=$(find ./charts -name \"Chart.yaml\" -not -path \"*/\\.git/*\" | head -1 | xargs dirname)\nCHART_NAME=$(yq e '.name' \"$CHART_DIR/Chart.yaml\")\nCHART_VERSION=$(yq e '.version' \"$CHART_DIR/Chart.yaml\")\nREPO_LOWER=$(echo \"$GITHUB_REPOSITORY\" | tr '[:upper:]' '[:lower:]')\necho \"chart_dir=$CHART_DIR\" >> $GITHUB_OUTPUT\necho \"chart_name=$CHART_NAME\" >> $GITHUB_OUTPUT\necho \"chart_version=$CHART_VERSION\" >> $GITHUB_OUTPUT\necho \"repo_lower=$REPO_LOWER\" >> $GITHUB_OUTPUT\necho \"Chart: $CHART_NAME:$CHART_VERSION in $CHART_DIR\"\n"
            },
            {
              "name": "Login to GitHub Container Registry",
              "uses": "docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6",
              "with": {
                "registry": "ghcr.io",
                "username": "${{ github.actor }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Package Helm Chart",
              "run": "helm package \"$CHART_DIR\" --version \"$CHART_VERSION\"\n",
              "env": {
                "CHART_DIR": "${{ steps.chart-version.outputs.chart_dir }}",
                "CHART_VERSION": "${{ steps.chart-version.outputs.chart_version }}"
              }
            },
            {
              "name": "Push to GitHub Container Registry",
              "run": "helm push \"${CHART_NAME}-${CHART_VERSION}.tgz\" \"oci://ghcr.io/${REPO_LOWER}/charts\"\n",
              "env": {
                "CHART_NAME": "${{ steps.chart-version.outputs.chart_name }}",
                "CHART_VERSION": "${{ steps.chart-version.outputs.chart_version }}",
                "REPO_LOWER": "${{ steps.chart-version.outputs.repo_lower }}"
              }
            },
            {
              "name": "Run chart-releaser",
              "uses": "helm/chart-releaser-action@92c6b97fa9f664492a2592e0d1d80bc6bf378957",
              "env": {
                "CR_TOKEN": "${{ secrets.GITHUB_TOKEN }}",
                "CR_GENERATE_RELEASE_NOTES": "true"
              }
            }
          ]
        }
      },
