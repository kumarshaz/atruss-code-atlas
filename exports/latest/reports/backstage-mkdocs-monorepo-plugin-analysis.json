  "pipelines": [
    {
      "id": "deploy.yml",
      "path": ".github/workflows/deploy.yml",
      "name": "Build, Test & Deploy",
      "triggers": [
        "push"
      ],
      "jobs": {
        "test": {
          "name": "Test on Python ${{ matrix.python-version }}",
          "runs-on": "ubuntu-latest",
          "strategy": {
            "matrix": {
              "python-version": [
                "3",
                "3.9",
                "3.10",
                "3.11",
                "3.12"
              ]
            }
          },
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@master"
            },
            {
              "name": "Set up Python ${{ matrix.python-version }}",
              "uses": "actions/setup-python@master",
              "with": {
                "python-version": "${{ matrix.python-version }}"
              }
            },
            {
              "name": "Install Bats",
              "run": "./__tests__/setup-bats.sh"
            },
            {
              "name": "Install Python dependencies",
              "run": "./__tests__/setup-pip.sh"
            },
            {
              "name": "Tests",
              "run": "./__tests__/test-ci.sh"
            }
          ]
        },
        "build-docs": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Checkout",
              "uses": "actions/checkout@master"
            },
            {
              "name": "Setup Pages",
              "uses": "actions/configure-pages@v5"
            },
            {
              "name": "Set up Python ${{ matrix.python-version }}",
              "uses": "actions/setup-python@master",
              "with": {
                "python-version": 3.9
              }
            },
            {
              "name": "Install Python dependencies",
              "run": "./__tests__/setup-pip.sh"
            },
            {
              "name": "Build Docs",
              "run": "mkdocs build --theme material\n"
            },
            {
              "name": "Install Plugin",
              "run": "pip install -e ."
            },
            {
              "name": "Build Example Docs",
              "working-directory": "sample-docs/",
              "run": "mkdocs build --theme material \\\n      --site-dir ../site/monorepo-example/\n"
            },
            {
              "name": "Upload artifact",
              "uses": "actions/upload-pages-artifact@v3",
              "with": {
                "path": "./site"
              }
            }
          ]
        },
        "publish-docs": {
          "environment": {
            "name": "github-pages",
            "url": "${{ steps.deployment.outputs.page_url }}"
          },
          "runs-on": "ubuntu-latest",
          "needs": "build-docs",
          "steps": [
            {
              "name": "Deploy to GitHub Pages",
              "id": "deployment",
              "uses": "actions/deploy-pages@v4"
            }
          ]
        },
        "publish-pypi": {
          "runs-on": "ubuntu-latest",
          "needs": "test",
          "steps": [
            {
              "uses": "actions/checkout@master"
            },
            {
              "name": "Set up Python ${{ matrix.python-version }}",
              "uses": "actions/setup-python@master",
              "with": {
                "python-version": 3.9
              }
            },
            {
              "name": "Build Python distribution",
              "run": "pip install wheel\nrm -rf dist\npython setup.py bdist_wheel sdist --formats gztar\n"
            },
            {
              "name": "Publish a Python distribution to PyPI",
              "uses": "pypa/gh-action-pypi-publish@f3ebf87ba2883f1c40faf37d2bb42277f12179c8",
              "with": {
                "user": "__token__",
                "password": "${{ secrets.pypi_api_key }}"
              }
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "test",
          "name": "Test on Python ${{ matrix.python-version }}",
          "runner": "ubuntu-latest",
          "steps_count": 5,
          "needs": [],
