    {
      "id": "sync-omnibus.yml",
      "path": ".github/workflows/sync-omnibus.yml",
      "name": "Sync omnibus skills",
      "triggers": [
        "schedule",
        "workflow_dispatch"
      ],
      "jobs": {
        "sync-omnibus": {
          "runs-on": "ubuntu-latest",
          "steps": [
            {
              "name": "Generate GitHub App token",
              "id": "app-token",
              "uses": "actions/create-github-app-token@f8d387b68d61c58ab83c6c016672934102569859",
              "with": {
                "app-id": "${{ secrets.GH_APP_SKILLS_RELEASER_APP_ID }}",
                "private-key": "${{ secrets.GH_APP_SKILLS_RELEASER_PRIVATE_KEY }}"
              }
            },
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd",
              "with": {
                "ref": "${{ github.event.inputs.ref || github.ref }}",
                "token": "${{ steps.app-token.outputs.token }}"
              }
            },
            {
              "name": "Download skills from PostHog release",
              "env": {
                "GH_TOKEN": "${{ steps.app-token.outputs.token }}"
              },
              "run": "gh release download agent-skills-latest \\\n  --repo PostHog/posthog \\\n  --pattern 'skills.zip' \\\n  --dir /tmp\n"
            },
            {
              "name": "Download skills from context-mill",
              "run": "curl -fsSL --retry 2 --retry-delay 3 \\\n  -o /tmp/context-mill.zip \\\n  \"https://github.com/PostHog/context-mill/releases/latest/download/skills-mcp-resources.zip\"\n"
            },
            {
              "name": "Sync omnibus skills directory",
              "run": "MANIFEST=\"skills/omnibus/.sync-manifest\"\n\n# Delete only previously-synced skills (listed in manifest)\nif [ -f \"$MANIFEST\" ]; then\n  while IFS= read -r dir; do\n    [ -n \"$dir\" ] && rm -rf \"skills/omnibus/$dir\"\n  done < \"$MANIFEST\"\nfi\n\n# Extract PostHog release skills\nunzip -o /tmp/skills.zip -d skills/omnibus/\n\n# Extract context-mill skills (nested zips, strip omnibus- prefix)\ntmp_cm=$(mktemp -d)\nunzip -q -o /tmp/context-mill.zip -d \"$tmp_cm\"\ncm_manifest=$(mktemp)\nwhile read -r inner_zip; do\n  skill_name=\"$(basename \"$inner_zip\" .zip)\"\n  skill_name=\"${skill_name#omnibus-}\"\n  echo \"$skill_name\" >> \"$cm_manifest\"\n  mkdir -p \"skills/omnibus/$skill_name\"\n  unzip -q -o \"$inner_zip\" -d \"skills/omnibus/$skill_name\"\n  find \"skills/omnibus/$skill_name\" -name 'SKILL.md' -type f -exec sed -i 's/^\\(name: *\\)omnibus-/\\1/' {} +\n  find \"skills/omnibus/$skill_name\" -name 'SKILL.md' -type f -exec sed -i '/^  version: .*/d' {} +\ndone < <(find \"$tmp_cm\" -name 'omnibus-*.zip' -type f)\nrm -rf \"$tmp_cm\"\n\n# Rebuild manifest from both sources\n{\n  zipinfo -1 /tmp/skills.zip | grep '/' | cut -d'/' -f1\n  cat \"$cm_manifest\"\n} | sort -u > \"$MANIFEST\"\nrm -f \"$cm_manifest\"\n\n# Reconcile: remove any directory not in the new manifest\n# (catches orphans from past manual edits or partial deletions)\nfor d in skills/omnibus/*/; do\n  [ -d \"$d\" ] || continue\n  name=$(basename \"$d\")\n  grep -qFx \"$name\" \"$MANIFEST\" || rm -rf \"$d\"\ndone\n"
            },
            {
              "name": "Check for changes",
              "id": "check",
              "env": {
                "GH_TOKEN": "${{ steps.app-token.outputs.token }}"
              },
              "run": "git add -A skills/omnibus/\nif git diff --cached --quiet; then\n  echo \"No changes detected.\"\n  echo \"has_changes=false\" >> \"$GITHUB_OUTPUT\"\n  exit 0\nfi\necho \"has_changes=true\" >> \"$GITHUB_OUTPUT\"\n\n# Extract version info from both sources\nPH_BODY=$(gh release view agent-skills-latest --repo PostHog/posthog --json body -q '.body' 2>/dev/null || echo \"\")\nPH_VERSION=$(echo \"$PH_BODY\" | grep -oE 'agent-skills-v[0-9.]+' | head -1)\n\nCM_TAG=$(gh release view --repo PostHog/context-mill --json tagName -q '.tagName' 2>/dev/null || echo \"\")\n\nVERSIONS=\"\"\n[ -n \"$PH_VERSION\" ] && VERSIONS=\"$PH_VERSION\"\n[ -n \"$CM_TAG\" ] && VERSIONS=\"${VERSIONS:+$VERSIONS, }context-mill@$CM_TAG\"\nVERSIONS=\"${VERSIONS:-latest}\"\n\necho \"commit_message=chore: sync omnibus skills ($VERSIONS)\" >> \"$GITHUB_OUTPUT\"\n"
            },
            {
              "name": "Create sync branch",
              "if": "steps.check.outputs.has_changes == 'true'",
              "id": "branch",
              "run": "BRANCH=\"chore/sync-omnibus-$(date +%Y%m%d-%H%M%S)\"\ngit checkout -b \"$BRANCH\"\ngit push origin \"$BRANCH\"\necho \"branch=$BRANCH\" >> \"$GITHUB_OUTPUT\"\necho \"base=$BASE_REF\" >> \"$GITHUB_OUTPUT\"\n",
              "env": {
                "BASE_REF": "${{ github.event.inputs.ref || github.ref_name }}"
              }
            },
            {
              "name": "Commit and push",
              "if": "steps.check.outputs.has_changes == 'true'",
              "uses": "planetscale/ghcommit-action@25309d8005ac7c3bcd61d3fe19b69e0fe47dbdde",
              "with": {
                "commit_message": "${{ steps.check.outputs.commit_message }}",
                "repo": "${{ github.repository }}",
                "branch": "${{ steps.branch.outputs.branch }}"
              },
              "env": {
                "GITHUB_TOKEN": "${{ steps.app-token.outputs.token }}"
              }
            },
            {
              "name": "Create PR with auto-merge",
              "if": "steps.check.outputs.has_changes == 'true'",
              "env": {
                "GH_TOKEN": "${{ steps.app-token.outputs.token }}",
                "COMMIT_MESSAGE": "${{ steps.check.outputs.commit_message }}",
                "BASE_REF": "${{ steps.branch.outputs.base }}",
                "HEAD_REF": "${{ steps.branch.outputs.branch }}"
              },
              "run": "PR_URL=$(gh pr create \\\n  --base \"$BASE_REF\" \\\n  --head \"$HEAD_REF\" \\\n  --title \"$COMMIT_MESSAGE\" \\\n  --body \"Automated skill sync from PostHog release and context-mill.\")\n\ngh pr edit \"$PR_URL\" --add-reviewer \"PostHog/team-self-driving\" \\\n  || echo \"::warning::Could not request review from PostHog/team-self-driving; continuing to auto-merge\"\n\ngh pr merge \"$PR_URL\" --auto --squash\n"
            }
          ]
        }
      },
      "job_nodes": [
