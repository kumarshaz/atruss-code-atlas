      "name": "Generate Marketplace",
      "triggers": [
        "push",
        "workflow_dispatch"
      ],
      "jobs": {
        "generate-marketplace": {
          "runs-on": "ubuntu-latest",
          "permissions": {
            "contents": "write",
            "pull-requests": "write"
          },
          "steps": [
            {
              "name": "Checkout repository",
              "uses": "actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5"
            },
            {
              "name": "Discover plugins and generate marketplace.json",
              "run": "./scripts/generate-marketplace.sh"
            },
            {
              "name": "Check whether marketplace.json changed",
              "id": "changes",
              "run": "if git diff --quiet .claude-plugin/marketplace.json; then\n  echo \"No changes to marketplace.json\"\n  echo \"changed=false\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"changed=true\" >> \"$GITHUB_OUTPUT\"\nfi\n"
            },
            {
              "name": "Reset the marketplace branch",
              "if": "steps.changes.outputs.changed == 'true'",
              "run": "git push -f origin \"HEAD:refs/heads/auto/update-marketplace\""
            },
            {
              "name": "Commit marketplace.json",
              "if": "steps.changes.outputs.changed == 'true'",
              "uses": "planetscale/ghcommit-action@a6b150b81dca5dd027baa898604418eec9e11465",
              "with": {
                "commit_message": "Update marketplace.json (auto-discovered plugins)",
                "repo": "${{ github.repository }}",
                "branch": "auto/update-marketplace",
                "file_pattern": ".claude-plugin/marketplace.json"
              },
              "env": {
                "GITHUB_TOKEN": "${{ github.token }}"
              }
            },
            {
              "name": "Open PR if marketplace.json changed",
              "if": "steps.changes.outputs.changed == 'true'",
              "env": {
                "GH_TOKEN": "${{ github.token }}"
              },
              "run": "BRANCH=\"auto/update-marketplace\"\n\n# Create PR if one doesn't already exist\nEXISTING=$(gh pr list --head \"$BRANCH\" --state open --json number --jq 'length')\nif [ \"$EXISTING\" -eq 0 ]; then\n  gh pr create \\\n    --title \"Update marketplace.json\" \\\n    --body \"Auto-generated by the marketplace discovery workflow. Merge to update the plugin catalog.\" \\\n    --head \"$BRANCH\" \\\n    --base main\nelse\n  echo \"PR already exists, updated branch\"\nfi\n"
            }
          ]
        }
      },
      "job_nodes": [
        {
          "id": "generate-marketplace",
          "name": "generate-marketplace",
          "runner": "ubuntu-latest",
          "steps_count": 6,
