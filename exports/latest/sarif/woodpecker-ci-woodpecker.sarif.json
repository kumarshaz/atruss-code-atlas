{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-SEC-005",
              "name": "HIGH_ENTROPY_SECRET",
              "shortDescription": {
                "text": "High-entropy credential candidate detected."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "secret"
                ]
              },
              "help": {
                "text": "Remove hardcoded credential and use secret management."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.60 > 4.5) detected. Snippet: \"secret\": \"l26U***REDACTED***\","
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/forge/forgejo/fixtures/HookTag.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "secret",
            "repository": "woodpecker-ci/woodpecker",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.60 > 4.5) detected. Snippet: \"secret\": \"l26U***REDACTED***\","
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/forge/gitea/fixtures/HookTag.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 3
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "secret",
            "repository": "woodpecker-ci/woodpecker",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        },
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository max_cyclomatic_complexity (28.0) exceeds policy threshold (20.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "web/src/compositions/usePipeline.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "woodpecker-ci/woodpecker"
          }
        }
      ]
    }
  ]
}
