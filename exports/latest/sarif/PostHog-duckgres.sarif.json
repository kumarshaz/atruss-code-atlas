{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-PIPE-001",
              "name": "NO_TEST_GATE",
              "shortDescription": {
                "text": "Deployment job executes without an upstream test gate in its needs chain."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Add a 'needs:' dependency on a test or verification job before executing deployment steps."
              }
            },
            {
              "id": "ATRUSS-PIPE-003",
              "name": "NO_ARTIFACT_HANDOFF",
              "shortDescription": {
                "text": "Multi-job build and deploy workflow lacks artifact handoff."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Publish immutable build outputs with actions/upload-artifact or push signed container images before deploying."
              }
            },
            {
              "id": "ATRUSS-PIPE-005",
              "name": "SEQUENTIAL_ONLY",
              "shortDescription": {
                "text": "Workflow chains jobs strictly sequentially with no parallel branches."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Parallelize independent jobs such as linting, unit testing, and security scanning to reduce pipeline cycle time."
              }
            },
            {
              "id": "ATRUSS-PIPE-011",
              "name": "EXCESSIVE_PERMISSIONS",
              "shortDescription": {
                "text": "Workflow grants write-all or omits least-privilege permissions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            },
            {
              "id": "ATRUSS-PIPE-013",
              "name": "ARTIFACT_CREDENTIAL_PERSISTENCE",
              "shortDescription": {
                "text": "actions/checkout persists git credentials in job that uploads artifacts."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set 'with: persist-credentials: false' on actions/checkout steps in jobs that upload artifacts."
              }
            },
            {
              "id": "ATRUSS-SEC-004",
              "name": "PRIVATE_KEY",
              "shortDescription": {
                "text": "Private key material header detected."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "secret"
                ]
              },
              "help": {
                "text": "Remove hardcoded credential and use secret management."
              }
            }
          ]
        }
      },
