          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "langfuse/langfuse-terraform-aws",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-001",
          "level": "error",
          "message": {
            "text": "CRITICAL: Job 'prepare' performs deployment without upstream test gates ('needs:' block is empty)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
