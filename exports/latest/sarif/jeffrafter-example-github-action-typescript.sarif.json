{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-PIPE-002",
              "name": "NO_CACHE",
              "shortDescription": {
                "text": "Workflow installs dependencies without caching configured."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Enable built-in caching on setup-* actions (e.g., cache: 'pip' or 'npm') or add an explicit actions/cache step."
              }
            },
            {
              "id": "ATRUSS-PIPE-011",
              "name": "EXCESSIVE_PERMISSIONS",
              "shortDescription": {
                "text": "Workflow grants write-all or omits least-privilege permissions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository duplication_pct (43.74) exceeds policy threshold (15.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/actions/thanks-action/thanks.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "jeffrafter/example-github-action-typescript"
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/debug-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'build' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/debug-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 18
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-002",
          "level": "warning",
          "message": {
            "text": "MEDIUM: Workflow installs dependencies without 'actions/cache' or setup action caching."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/debug-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 12
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Enable built-in caching on setup-* actions (e.g., cache: 'pip' or 'npm') or add an explicit actions/cache step."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/thanks-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 2
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'build' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/thanks-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "endLine": 18
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-002",
          "level": "warning",
          "message": {
            "text": "MEDIUM: Workflow installs dependencies without 'actions/cache' or setup action caching."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/thanks-workflow.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 12
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "jeffrafter/example-github-action-typescript",
            "remediation": "Enable built-in caching on setup-* actions (e.g., cache: 'pip' or 'npm') or add an explicit actions/cache step."
          }
        }
      ]
    }
  ]
}
