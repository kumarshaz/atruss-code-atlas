            "remediation": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-001",
          "level": "error",
          "message": {
            "text": "HIGH: Job 'publish' performs deployment without an upstream test job in its 'needs:' chain."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
