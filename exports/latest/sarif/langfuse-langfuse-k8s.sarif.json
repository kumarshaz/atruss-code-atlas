          "level": "error",
          "message": {
            "text": "CRITICAL: Job 'validate' performs deployment without upstream test gates ('needs:' block is empty)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/validate.yaml",
