{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-PIPE-009",
              "name": "TEMPLATE_INJECTION",
              "shortDescription": {
                "text": "Workflow run block interpolates untrusted event context or writes to GITHUB_ENV/PATH."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Pass untrusted GitHub context values through intermediate step 'env:' variables, quote shell expansions, and avoid writing untrusted data to $GITHUB_ENV or $GITHUB_PATH."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            },
            {
              "id": "ATRUSS-SEC-005",
              "name": "HIGH_ENTROPY_SECRET",
              "shortDescription": {
                "text": "High-entropy credential candidate detected."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "secret"
                ]
              },
              "help": {
                "text": "Remove hardcoded credential and use secret management."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'verify' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "endLine": 41
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "mattermost/mattermost-load-test-ng",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-009",
          "level": "error",
          "message": {
            "text": "Job 'verify' step 4 interpolates untrusted event context or writes untrusted data to $GITHUB_ENV/$GITHUB_PATH."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 30,
                  "endLine": 36
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "category": "pipeline",
            "repository": "mattermost/mattermost-load-test-ng",
            "remediation": "Pass untrusted GitHub context values through intermediate step 'env:' variables, quote shell expansions, and avoid writing untrusted data to $GITHUB_ENV or $GITHUB_PATH."
          }
        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.56 > 4.5) detected. Snippet: \"secret\": \"qbdU***REDACTED***\","
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "deployment/terraform/assets/mattermost-realm.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 958,
                  "endLine": 958
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "secret",
            "repository": "mattermost/mattermost-load-test-ng",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=5.98 > 4.5) detected. Snippet: \"saml.signing.private.key\": \"MIIE***REDACTED***\","
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "deployment/terraform/assets/mattermost-realm.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1087,
                  "endLine": 1087
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "secret",
            "repository": "mattermost/mattermost-load-test-ng",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        }
      ]
    }
  ]
}
