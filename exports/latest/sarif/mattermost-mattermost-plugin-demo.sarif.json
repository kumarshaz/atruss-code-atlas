{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-PIPE-001",
              "name": "NO_TEST_GATE",
              "shortDescription": {
                "text": "Deployment job executes without an upstream test gate in its needs chain."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Add a 'needs:' dependency on a test or verification job before executing deployment steps."
              }
            },
            {
              "id": "ATRUSS-PIPE-004",
              "name": "HARDCODED_SECRET",
              "shortDescription": {
                "text": "Potential hardcoded credential detected in workflow definition."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Remove literal secret values and reference encrypted GitHub Secrets via ${{ secrets.SECRET_NAME }} or OIDC federation."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'plugin-ci' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "endLine": 18
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "mattermost/mattermost-plugin-demo",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-001",
          "level": "error",
          "message": {
            "text": "CRITICAL: Job 'deploy-test' performs deployment without upstream test gates ('needs:' block is empty)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/e2e.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 158
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "category": "pipeline",
            "repository": "mattermost/mattermost-plugin-demo",
            "remediation": "Add a 'needs:' dependency on a test or verification job before executing deployment steps."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'deploy-test' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/e2e.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 158
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "mattermost/mattermost-plugin-demo",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-004",
          "level": "error",
          "message": {
            "text": "Potential hardcoded credential in job 'deploy-test' env 'MM_ADMIN_PASSWORD'. Use GitHub Secrets instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/e2e.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 35,
                  "endLine": 35
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "category": "pipeline",
            "repository": "mattermost/mattermost-plugin-demo",
            "remediation": "Remove literal secret values and reference encrypted GitHub Secrets via ${{ secrets.SECRET_NAME }} or OIDC federation."
          }
        },
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository duplication_pct (76.77) exceeds policy threshold (15.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "webapp/src/components/right_hand_sidebar/components_tab/specimens/live_overlays.tsx",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "mattermost/mattermost-plugin-demo"
          }
        }
      ]
    }
  ]
}
