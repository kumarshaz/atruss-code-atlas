          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.53 > 4.5) detected. Snippet: \"nested\": map[string]any{\"apiKey\": \"stan***REDACTED***\"},"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/output/redact_test.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
