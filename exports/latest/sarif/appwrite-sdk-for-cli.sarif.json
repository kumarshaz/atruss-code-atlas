          }
        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.53 > 4.5) detected. Snippet: input := map[string]any{\"secret\": \"stan***REDACTED***\"}"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/output/redact_test.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 140,
