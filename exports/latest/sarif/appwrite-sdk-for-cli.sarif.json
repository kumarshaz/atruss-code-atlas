        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.53 > 4.5) detected. Snippet: const sourceDocument = `{\"name\":\"proj\",\"url\":\"https://x.io/?a=1&b=2\",\"nested\":{\"apiKey\":\"stan***REDACTED***\"},\"list\":[{\"secret\":\"short\"},1,null,true]}`"
          },
          "locations": [
            {
              "physicalLocation": {
