          "properties": {
            "severity": "CRITICAL",
            "category": "secret",
            "repository": "appwrite/sdk-for-cli",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        },
        {
          "ruleId": "ATRUSS-SEC-004",
          "level": "error",
          "message": {
            "text": "Private key material header detected. Snippet: -----BEGIN ... PRIVATE KEY----- [REDACTED]"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/cmd/services/project.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1152,
                  "endLine": 1152
                }
              }
            }
          ],
          "properties": {
            "severity": "CRITICAL",
            "category": "secret",
            "repository": "appwrite/sdk-for-cli",
            "remediation": "Remove hardcoded credential and use secret management."
          }
        },
        {
          "ruleId": "ATRUSS-SEC-005",
          "level": "error",
          "message": {
            "text": "High-entropy credential candidate (H=4.53 > 4.5) detected. Snippet: \"apiKey\": \"stan***REDACTED***\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "internal/output/json_test.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 19,
                  "endLine": 19
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "secret",
            "repository": "appwrite/sdk-for-cli",
