{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-004",
              "name": "CIRCULAR_DEPENDENCY",
              "shortDescription": {
                "text": "Circular dependency detected between architectural components."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-PIPE-009",
              "name": "TEMPLATE_INJECTION",
              "shortDescription": {
                "text": "Workflow run block interpolates untrusted event context or writes to GITHUB_ENV/PATH."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Pass untrusted GitHub context values through intermediate step 'env:' variables, quote shell expansions, and avoid writing untrusted data to $GITHUB_ENV or $GITHUB_PATH."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            },
            {
              "id": "ATRUSS-PIPE-013",
              "name": "ARTIFACT_CREDENTIAL_PERSISTENCE",
              "shortDescription": {
                "text": "actions/checkout persists git credentials in job that uploads artifacts."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set 'with: persist-credentials: false' on actions/checkout steps in jobs that upload artifacts."
              }
            },
            {
              "id": "ATRUSS-PIPE-014",
              "name": "STATIC_CLOUD_CREDENTIALS",
              "shortDescription": {
                "text": "Cloud authentication uses static keys instead of OIDC id-token federation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Configure short-lived OIDC federation with 'permissions: id-token: write' and replace long-lived static cloud keys."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-013",
          "level": "warning",
          "message": {
            "text": "Job 'build' runs actions/checkout without 'persist-credentials: false' and uploads build artifacts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/build-release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 130,
                  "endLine": 130
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "RocketChat/Rocket.Chat.Electron",
            "remediation": "Set 'with: persist-credentials: false' on actions/checkout steps in jobs that upload artifacts."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-014",
          "level": "error",
          "message": {
            "text": "Job 'build' step 10 uses cloud authentication without OIDC 'id-token: write' or relies on static cloud keys."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/build-release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 182,
                  "endLine": 182
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "RocketChat/Rocket.Chat.Electron",
            "remediation": "Configure short-lived OIDC federation with 'permissions: id-token: write' and replace long-lived static cloud keys."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'lint' omits 'timeout-minutes', risking 360-minute hung runners."
          },
