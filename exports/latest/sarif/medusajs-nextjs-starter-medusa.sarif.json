{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository duplication_pct (75.93) exceeds policy threshold (15.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/modules/checkout/components/shipping/index.tsx",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "medusajs/nextjs-starter-medusa"
          }
        },
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository max_cognitive_complexity (41.0) exceeds policy threshold (25.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/modules/checkout/components/shipping/index.tsx",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "medusajs/nextjs-starter-medusa"
          }
        },
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository max_cyclomatic_complexity (35.0) exceeds policy threshold (20.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/modules/checkout/components/shipping/index.tsx",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "medusajs/nextjs-starter-medusa"
          }
        }
      ]
    }
  ]
}
