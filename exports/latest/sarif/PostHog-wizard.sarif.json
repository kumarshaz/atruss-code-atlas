                "region": {
                  "startLine": 2,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "PostHog/wizard",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
