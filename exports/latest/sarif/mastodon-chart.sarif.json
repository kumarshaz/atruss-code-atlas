{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-PIPE-002",
              "name": "NO_CACHE",
              "shortDescription": {
                "text": "Workflow installs dependencies without caching configured."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Enable built-in caching on setup-* actions (e.g., cache: 'pip' or 'npm') or add an explicit actions/cache step."
              }
            },
            {
              "id": "ATRUSS-PIPE-008",
              "name": "UNPINNED_ACTION",
              "shortDescription": {
                "text": "Third-party GitHub Action is not pinned to a 40-character commit SHA."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'lint-templates' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test-chart.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 19,
                  "endLine": 50
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "mastodon/chart",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-002",
          "level": "warning",
          "message": {
            "text": "MEDIUM: Workflow installs dependencies without 'actions/cache' or setup action caching."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test-chart.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 29,
                  "endLine": 29
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "mastodon/chart",
            "remediation": "Enable built-in caching on setup-* actions (e.g., cache: 'pip' or 'npm') or add an explicit actions/cache step."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-008",
          "level": "error",
          "message": {
            "text": "Job 'test-install' step 2 uses unpinned action 'jupyterhub/action-k3s-helm@v4'. Pin to a 40-character commit SHA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test-chart.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 92,
                  "endLine": 92
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "mastodon/chart",
            "remediation": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-008",
          "level": "error",
          "message": {
            "text": "Job 'test-install' step 6 uses unpinned action 'jupyterhub/action-k8s-namespace-report@v1'. Pin to a 40-character commit SHA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test-chart.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 121,
                  "endLine": 121
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "mastodon/chart",
            "remediation": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
          }
        }
      ]
    }
  ]
}
