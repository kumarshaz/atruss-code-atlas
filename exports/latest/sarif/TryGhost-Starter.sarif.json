{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-ARCH-005",
              "name": "COMPLEXITY_THRESHOLD",
              "shortDescription": {
                "text": "Code quality metric exceeds configured architectural threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "architecture"
                ]
              }
            },
            {
              "id": "ATRUSS-PIPE-003",
              "name": "NO_ARTIFACT_HANDOFF",
              "shortDescription": {
                "text": "Multi-job build and deploy workflow lacks artifact handoff."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Publish immutable build outputs with actions/upload-artifact or push signed container images before deploying."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'test' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/deploy-theme.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 13,
                  "endLine": 32
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "TryGhost/Starter",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-003",
          "level": "warning",
          "message": {
            "text": "Workflow has build and deploy stages without artifact handoff (upload-artifact / container push)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/deploy-theme.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 34,
                  "endLine": 48
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "TryGhost/Starter",
            "remediation": "Publish immutable build outputs with actions/upload-artifact or push signed container images before deploying."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'deploy' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/deploy-theme.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 34,
                  "endLine": 48
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "TryGhost/Starter",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'test' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 29
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "TryGhost/Starter",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'required-checks-pass' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/test.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 31,
                  "endLine": 39
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "TryGhost/Starter",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-ARCH-005",
          "level": "warning",
          "message": {
            "text": "Repository duplication_pct (38.68) exceeds policy threshold (15.0)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "assets/js/infiniteScroll.js",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "architecture",
            "repository": "TryGhost/Starter"
          }
        }
      ]
    }
  ]
}
