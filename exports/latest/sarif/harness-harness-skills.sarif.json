        {
          "ruleId": "ATRUSS-SEC-001",
          "level": "error",
          "message": {
            "text": "Potential hardcoded AWS Access Key ID detected. Snippet: accessKey: AKIA***REDACTED***"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/connectors/registry-connectors.yaml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 46
