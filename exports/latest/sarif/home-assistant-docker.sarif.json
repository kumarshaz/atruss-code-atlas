{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-PIPE-001",
              "name": "NO_TEST_GATE",
              "shortDescription": {
                "text": "Deployment job executes without an upstream test gate in its needs chain."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Add a 'needs:' dependency on a test or verification job before executing deployment steps."
              }
            },
            {
              "id": "ATRUSS-PIPE-003",
              "name": "NO_ARTIFACT_HANDOFF",
              "shortDescription": {
                "text": "Multi-job build and deploy workflow lacks artifact handoff."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Publish immutable build outputs with actions/upload-artifact or push signed container images before deploying."
              }
            },
            {
              "id": "ATRUSS-PIPE-008",
              "name": "UNPINNED_ACTION",
              "shortDescription": {
                "text": "Third-party GitHub Action is not pinned to a 40-character commit SHA."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
              }
            },
            {
              "id": "ATRUSS-PIPE-011",
              "name": "EXCESSIVE_PERMISSIONS",
              "shortDescription": {
                "text": "Workflow grants write-all or omits least-privilege permissions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'init' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 26,
                  "endLine": 49
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-008",
          "level": "error",
          "message": {
            "text": "Job 'init' step 2 uses unpinned action 'home-assistant/actions/helpers/version@master'. Pin to a 40-character commit SHA."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 40,
                  "endLine": 40
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Pin third-party actions to a full 40-character commit SHA (for example, uses: owner/action@<40-hex-sha> # v1.2.3)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'build' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 51,
                  "endLine": 100
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-001",
          "level": "error",
          "message": {
            "text": "HIGH: Job 'manifest' performs deployment without an upstream test job in its 'needs:' chain."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 102,
                  "endLine": 119
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Add a 'needs:' dependency on a test or verification job before executing deployment steps."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-003",
          "level": "warning",
          "message": {
            "text": "Workflow has build and deploy stages without artifact handoff (upload-artifact / container push)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 102,
                  "endLine": 119
                }
              }
            }
          ],
          "properties": {
            "severity": "MEDIUM",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Publish immutable build outputs with actions/upload-artifact or push signed container images before deploying."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'manifest' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/builder.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 102,
                  "endLine": 119
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/hadolint.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2,
                  "endLine": 6
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'golangci' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/hadolint.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "endLine": 13
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release-drafter.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 6
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "home-assistant/docker",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-001",
          "level": "error",
          "message": {
            "text": "CRITICAL: Job 'update_release_draft' performs deployment without upstream test gates ('needs:' block is empty)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release-drafter.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9,
