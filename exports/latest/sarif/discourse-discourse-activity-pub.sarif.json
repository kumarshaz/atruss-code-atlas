{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "atruss-code-atlas",
          "version": "0.1.0",
          "informationUri": "https://github.com/kumarshaz/atruss-code-atlas",
          "rules": [
            {
              "id": "ATRUSS-PIPE-011",
              "name": "EXCESSIVE_PERMISSIONS",
              "shortDescription": {
                "text": "Workflow grants write-all or omits least-privilege permissions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
              }
            },
            {
              "id": "ATRUSS-PIPE-012",
              "name": "NO_TIMEOUT",
              "shortDescription": {
                "text": "Job omits timeout-minutes configuration."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "atruss",
                  "pipeline"
                ]
              },
              "help": {
                "text": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/d-compat-branch.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 6
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "discourse/discourse-activity-pub",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'ci' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/d-compat-branch.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 9,
                  "endLine": 10
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "discourse/discourse-activity-pub",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-011",
          "level": "error",
          "message": {
            "text": "Workflow omits explicit 'permissions:' block, inheriting default GITHUB_TOKEN permissions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/discourse-plugin.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "endLine": 7
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "discourse/discourse-activity-pub",
            "remediation": "Declare explicit least-privilege 'permissions:' (for example, contents: read) at the workflow or job level."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-012",
          "level": "note",
          "message": {
            "text": "Job 'ci' omits 'timeout-minutes', risking 360-minute hung runners."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/discourse-plugin.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 11
                }
              }
            }
          ],
          "properties": {
            "severity": "LOW",
            "category": "pipeline",
            "repository": "discourse/discourse-activity-pub",
            "remediation": "Set an explicit 'timeout-minutes:' value on every job (for example, timeout-minutes: 15)."
          }
        }
      ]
    }
  ]
}
