          }
        },
        {
          "ruleId": "ATRUSS-PIPE-014",
          "level": "error",
          "message": {
            "text": "Job 'build' step 6 uses cloud authentication without OIDC 'id-token: write' or relies on static cloud keys."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/azure-dev.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 39,
                  "endLine": 50
                }
              }
            }
          ],
          "properties": {
            "severity": "HIGH",
            "category": "pipeline",
            "repository": "Azure-Samples/todo-nodejs-mongo-terraform",
            "remediation": "Configure short-lived OIDC federation with 'permissions: id-token: write' and replace long-lived static cloud keys."
          }
        },
        {
          "ruleId": "ATRUSS-PIPE-014",
          "level": "error",
          "message": {
