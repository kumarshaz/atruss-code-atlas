          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/azure-dev.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 29,
