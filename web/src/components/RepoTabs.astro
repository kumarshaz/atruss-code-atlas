---
interface Props {
    org: string;
    repo_name: string;
    language?: string;
    framework?: string;
    doc_priority?: string;
    last_updated?: string | Date;
    github_url?: string;
}

const {
    org,
    repo_name,
    language = 'Unknown',
    framework,
    doc_priority = 'P3',
    last_updated,
    github_url,
} = Astro.props;

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const withBase = (p: string) => `${baseUrl}${p.startsWith('/') ? p : '/' + p}`;
const tabGroupId = `${org}-${repo_name}`.replace(/[^a-zA-Z0-9_-]/g, '-').toLowerCase();

const priorityClass =
    doc_priority === 'P1'
        ? 'm3-chip-tonal-error'
        : doc_priority === 'P2'
          ? 'm3-chip-tonal-warning'
          : 'm3-chip-tonal-secondary';
---

<div class="m3-report-shell" data-m3-tabs-root={tabGroupId}>
    <section class="m3-card-filled m3-report-header">
        <div class="m3-report-header-main">
            <div class="m3-report-breadcrumb">
                <a href={withBase('/')} class="m3-breadcrumb-link">Atlas Overview</a>
                <span aria-hidden="true">/</span>
                <span>{org}</span>
            </div>
            <h2 class="m3-report-repo-name">{repo_name}</h2>
            <div class="m3-report-badges">
                <span class="m3-chip m3-chip-tonal-primary">
                    <span class="material-symbols-outlined" aria-hidden="true">code</span>
                    {language}
                </span>
                {framework && framework !== 'Unknown' && (
                    <span class="m3-chip">{framework}</span>
                )}
                <span class={`m3-chip ${priorityClass}`}>{doc_priority}</span>
                {last_updated && (
                    <span class="m3-chip">
                        <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                        {new Date(last_updated).toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                        })}
                    </span>
                )}
            </div>
        </div>

        {github_url && (
            <a
                href={github_url}
                target="_blank"
                rel="noopener noreferrer"
                class="m3-btn-tonal m3-report-gh-btn"
            >
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                View Repository
            </a>
        )}
    </section>

    <div class="m3-tabs-bar" role="tablist" aria-label="Repository analysis views">
        <button
            type="button"
            role="tab"
            id={`${tabGroupId}-tab-discovery`}
            aria-controls={`${tabGroupId}-panel-discovery`}
            aria-selected="true"
            data-m3-tab="discovery"
            class="m3-tab-btn is-active"
        >
            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
            <span>Discovery Overview</span>
        </button>

        <button
            type="button"
            role="tab"
            id={`${tabGroupId}-tab-pipeline`}
            aria-controls={`${tabGroupId}-panel-pipeline`}
            aria-selected="false"
            data-m3-tab="pipeline"
            class="m3-tab-btn"
        >
            <span class="material-symbols-outlined" aria-hidden="true">account_tree</span>
            <span>CI/CD Pipeline DAG</span>
        </button>

        <button
            type="button"
            role="tab"
            id={`${tabGroupId}-tab-architecture`}
            aria-controls={`${tabGroupId}-panel-architecture`}
            aria-selected="false"
            data-m3-tab="architecture"
            class="m3-tab-btn"
        >
            <span class="material-symbols-outlined" aria-hidden="true">architecture</span>
            <span>Arc42 Code Architecture</span>
        </button>
    </div>

    <div
        role="tabpanel"
        id={`${tabGroupId}-panel-discovery`}
        aria-labelledby={`${tabGroupId}-tab-discovery`}
        data-m3-panel="discovery"
        class="m3-tab-panel"
    >
        <slot name="discovery" />
    </div>

    <div
        role="tabpanel"
        id={`${tabGroupId}-panel-pipeline`}
        aria-labelledby={`${tabGroupId}-tab-pipeline`}
        data-m3-panel="pipeline"
        class="m3-tab-panel"
        hidden
    >
        <slot name="pipeline" />
    </div>

    <div
        role="tabpanel"
        id={`${tabGroupId}-panel-architecture`}
        aria-labelledby={`${tabGroupId}-tab-architecture`}
        data-m3-panel="architecture"
        class="m3-tab-panel"
        hidden
    >
        <slot name="architecture" />
    </div>
</div>

<script>
    function initM3Tabs() {
        document.querySelectorAll<HTMLElement>('[data-m3-tabs-root]').forEach((root) => {
            if (root.dataset.tabsBound === 'true') return;
            root.dataset.tabsBound = 'true';

            const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-m3-tab]'));
            const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-m3-panel]'));

            const selectTab = (targetKey: string) => {
                tabs.forEach((t) => {
                    const active = t.dataset.m3Tab === targetKey;
                    t.classList.toggle('is-active', active);
                    t.setAttribute('aria-selected', String(active));
                    t.tabIndex = active ? 0 : -1;
                });

                panels.forEach((p) => {
                    const active = p.dataset.m3Panel === targetKey;
                    p.hidden = !active;
                    if (active) {
                        requestAnimationFrame(() => {
                            document.dispatchEvent(
                                new CustomEvent('atruss:tab-activated', { detail: { panel: p } })
                            );
                        });
                    }
                });
            };

            tabs.forEach((tab, index) => {
                tab.addEventListener('click', () => {
                    selectTab(tab.dataset.m3Tab || 'discovery');
                });
                tab.addEventListener('keydown', (e) => {
                    if (e.key === 'ArrowRight') {
                        const next = tabs[(index + 1) % tabs.length];
                        next.focus();
                        selectTab(next.dataset.m3Tab || 'discovery');
                    } else if (e.key === 'ArrowLeft') {
                        const prev = tabs[(index - 1 + tabs.length) % tabs.length];
                        prev.focus();
                        selectTab(prev.dataset.m3Tab || 'discovery');
                    }
                });
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initM3Tabs);
    document.addEventListener('astro:page-load', initM3Tabs);
</script>

<style>
    .m3-report-shell {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .m3-report-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: var(--md-sys-shape-corner-extra-large);
    }

    .m3-report-breadcrumb {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8125rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-bottom: 0.35rem;
    }

    .m3-breadcrumb-link {
        color: var(--md-sys-color-primary);
        text-decoration: none;
        font-weight: 500;
    }

    .m3-breadcrumb-link:hover {
        text-decoration: underline;
    }

    .m3-report-repo-name {
        margin: 0 0 0.75rem !important;
        font-size: 1.5rem !important;
        font-weight: 700;
        color: var(--md-sys-color-on-surface);
    }

    .m3-report-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .m3-report-badges .material-symbols-outlined {
        font-size: 16px;
    }

    .m3-tabs-bar {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        gap: 0.25rem;
        border-bottom: 1px solid var(--md-sys-color-outline-variant);
        background-color: var(--md-sys-color-surface-container-low);
        border-radius: var(--md-sys-shape-corner-large) var(--md-sys-shape-corner-large) 0 0;
        padding: 0.375rem 0.5rem 0;
    }

    .m3-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.25rem;
        border: none;
        border-bottom: 3px solid transparent;
        background: transparent;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        border-radius: var(--md-sys-shape-corner-small) var(--md-sys-shape-corner-small) 0 0;
        transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
    }

    .m3-tab-btn:hover {
        background-color: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
    }

    .m3-tab-btn.is-active {
        color: var(--md-sys-color-primary);
        border-bottom-color: var(--md-sys-color-primary);
    }

    .m3-tab-btn .material-symbols-outlined {
        font-size: 18px;
    }

    .m3-tab-panel[hidden] {
        display: none;
    }
</style>
