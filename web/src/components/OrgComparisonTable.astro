---
interface OrgMaturityScore {
    org: string;
    total_repos: number;
    repos_with_pipeline: number;
    repos_with_docker: number;
    pipeline_coverage_pct: number;
    maturity_score: number;
    avg_scorecard?: number | null;
    avg_grade?: string | null;
    open_cves?: number | null;
    fitness_alerts?: number | null;
    primary_repo_name?: string;
    primary_repo_href?: string;
    primary_ecosystem?: string;
}

interface Props {
    orgs: OrgMaturityScore[];
}

const { orgs = [] } = Astro.props;

const sortedOrgs = [...orgs].sort((a, b) => b.maturity_score - a.maturity_score);

const getScoreBadgeClass = (score: number) => {
    if (score >= 75) return 'm3-chip-tonal-success';
    if (score >= 45) return 'm3-chip-tonal-warning';
    return 'm3-chip-tonal-error';
};
---

<div class="m3-table-surface m3-leaderboard-wrap">
    <table class="m3-leaderboard-table">
        <thead>
            <tr>
                <th>Rank</th>
                <th>Organization</th>
                <th>Total Repos</th>
                <th>Containerized</th>
                <th>Pipeline Coverage</th>
                <th>Maturity Score</th>
                <th>6-D Scorecard</th>
                <th>Security &amp; Fitness</th>
            </tr>
        </thead>
        <tbody>
            {sortedOrgs.length === 0 ? (
                <tr>
                    <td colspan="8" class="m3-empty-row">
                        No organization benchmarks available yet.
                    </td>
                </tr>
            ) : (
                sortedOrgs.map((org, index) => {
                    const pct = Math.round(org.pipeline_coverage_pct);
                    const score = Math.round(org.maturity_score);
                    const hasSc = typeof org.avg_scorecard === 'number';
                    const hasSec = org.open_cves !== null && org.open_cves !== undefined;
                    const href = org.primary_repo_href || '';
                    const isClean = hasSec && (org.open_cves ?? 0) === 0 && (org.fitness_alerts ?? 0) === 0;

                    return (
                        <tr
                            class={href ? 'm3-clickable-row' : undefined}
                            data-href={href || undefined}
                            tabindex={href ? 0 : undefined}
                            role={href ? 'link' : undefined}
                            aria-label={href ? `Open ${org.org} flagship report (${org.primary_repo_name})` : undefined}
                        >
                            <td class="m3-rank-cell">
                                {index < 3 ? (
                                    <span class="m3-chip m3-chip-tonal-primary">
                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            workspace_premium
                                        </span>
                                        #{index + 1}
                                    </span>
                                ) : (
                                    <span class="m3-rank-num">#{index + 1}</span>
                                )}
                            </td>
                            <td class="m3-org-cell">
                                {href ? (
                                    <a href={href} class="m3-org-link">
                                        <span class="m3-org-name">
                                            {org.org}
                                            <span class="material-symbols-outlined m3-org-arrow" aria-hidden="true">
                                                arrow_forward
                                            </span>
                                        </span>
                                        {(org.primary_ecosystem || org.primary_repo_name) && (
                                            <span class="m3-org-sub">
                                                {org.primary_ecosystem && (
                                                    <span class="m3-org-eco">{org.primary_ecosystem}</span>
                                                )}
                                                {org.primary_repo_name && (
                                                    <span class="m3-org-repo">→ {org.primary_repo_name}</span>
                                                )}
                                            </span>
                                        )}
                                    </a>
                                ) : (
                                    <span>{org.org}</span>
                                )}
                            </td>
                            <td class="m3-numeric-cell">{org.total_repos}</td>
                            <td class="m3-numeric-cell">{org.repos_with_docker}</td>
                            <td>
                                <div class="m3-coverage-cell">
                                    <div class="m3-coverage-track">
                                        <div class="m3-coverage-bar" style={`width: ${pct}%;`} />
                                    </div>
                                    <span class="m3-numeric-cell">{pct}%</span>
                                </div>
                            </td>
                            <td>
                                <span class={`m3-chip ${getScoreBadgeClass(score)}`}>
                                    {score} / 100
                                </span>
                            </td>
                            <td>
                                {hasSc ? (
                                    <span
                                        class={`m3-chip ${getScoreBadgeClass(org.avg_scorecard || 0)}`}
                                    >
                                        Grade {org.avg_grade || '?'} ({org.avg_scorecard})
                                    </span>
                                ) : (
                                    <span class="m3-empty-cell">—</span>
                                )}
                            </td>
                            <td class="m3-numeric-cell">
                                {hasSec ? (
                                    <span class={`m3-chip ${isClean ? 'm3-chip-tonal-success' : 'm3-chip-tonal-warning'}`}>
                                        <span class="material-symbols-outlined" aria-hidden="true">
                                            {isClean ? 'verified' : 'warning'}
                                        </span>
                                        {org.open_cves} CVE · {org.fitness_alerts ?? 0} Rule
                                    </span>
                                ) : (
                                    <span class="m3-empty-cell">—</span>
                                )}
                            </td>
                        </tr>
                    );
                })
            )}
        </tbody>
    </table>
</div>

<script>
    const initClickableLeaderboard = () => {
        document.querySelectorAll<HTMLTableRowElement>('tr.m3-clickable-row[data-href]').forEach((row) => {
            if (row.dataset.bound === '1') return;
            row.dataset.bound = '1';

            row.addEventListener('click', (event) => {
                const target = event.target as HTMLElement | null;
                if (target && target.closest('a, button')) return;
                const href = row.dataset.href;
                if (href) window.location.href = href;
            });

            row.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    const href = row.dataset.href;
                    if (href) window.location.href = href;
                }
            });
        });
    };

    initClickableLeaderboard();
    document.addEventListener('astro:after-swap', initClickableLeaderboard);
</script>

<style>
    .m3-leaderboard-wrap {
        margin: 1.5rem 0;
        overflow-x: auto;
        max-width: 100%;
    }

    .m3-leaderboard-table {
        width: 100%;
        table-layout: auto;
    }

    tr.m3-clickable-row {
        cursor: pointer;
        transition: background-color 150ms ease;
    }

    tr.m3-clickable-row:hover {
        background-color: var(--md-sys-color-surface-container-high);
    }

    tr.m3-clickable-row:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: -2px;
    }

    .m3-rank-cell {
        width: 80px;
        white-space: nowrap;
    }

    .m3-rank-cell .material-symbols-outlined,
    td .m3-chip .material-symbols-outlined {
        font-size: 16px;
    }

    .m3-rank-num {
        font-family: var(--md-ref-typeface-mono);
        font-weight: 600;
        color: var(--md-sys-color-on-surface-variant);
    }

    .m3-org-cell {
        font-weight: 600;
        color: var(--md-sys-color-on-surface);
        overflow-wrap: anywhere;
    }

    .m3-org-link {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        color: inherit;
        text-decoration: none;
    }

    .m3-org-name {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--md-sys-color-primary);
    }

    .m3-org-arrow {
        font-size: 15px;
        opacity: 0.7;
        transition: transform 150ms ease, opacity 150ms ease;
    }

    tr.m3-clickable-row:hover .m3-org-arrow {
        opacity: 1;
        transform: translateX(2px);
    }

    .m3-org-sub {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
    }

    .m3-org-eco {
        padding: 0.05rem 0.4rem;
        border-radius: var(--md-sys-shape-corner-small);
        background-color: var(--md-sys-color-surface-container-highest);
        font-family: var(--md-ref-typeface-mono);
    }

    .m3-org-repo {
        font-family: var(--md-ref-typeface-mono);
    }

    .m3-numeric-cell {
        font-family: var(--md-ref-typeface-mono);
        font-weight: 600;
        white-space: nowrap;
    }

    .m3-coverage-cell {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        min-width: 120px;
    }

    .m3-coverage-track {
        flex: 1;
        height: 0.5rem;
        background-color: var(--md-sys-color-surface-container-highest);
        border-radius: var(--md-sys-shape-corner-full);
        overflow: hidden;
    }

    .m3-coverage-bar {
        height: 100%;
        background-color: var(--md-sys-color-primary);
        border-radius: var(--md-sys-shape-corner-full);
    }

    .m3-empty-cell {
        color: var(--md-sys-color-on-surface-variant);
        font-family: var(--md-ref-typeface-mono);
        opacity: 0.7;
    }

    .m3-empty-row {
        text-align: center !important;
        padding: 2rem !important;
        color: var(--md-sys-color-on-surface-variant);
    }
</style>
