                                    </div>
                                    <code class="m3-workspace-path">{pkg.path}</code>
                                    {Array.isArray(pkg.internal_dependencies) && pkg.internal_dependencies.length > 0 && (
                                        <div class="m3-workspace-deps">
                                            Internal deps: {pkg.internal_dependencies.join(', ')}
                                        </div>
                                    )}
                                </article>
                            ))}
                        </div>
                    )}
                </div>

                <div class="m3-trace-col">
                    <h5>Code-to-Cloud Traceability Links</h5>
                    {codeToCloudEdges.length === 0 ? (
                        <p class="m3-empty-note">No Code-to-Cloud container, IaC, or deploy environment edges detected.</p>
