                                        <strong>{edge.source}</strong>
                                        <small>({edge.source_type})</small>
                                    </span>
                                    <span class="m3-chip m3-chip-tonal-tertiary m3-c2c-rel">
                                        {edge.relationship}
                                    </span>
                                    <span class="m3-c2c-node">
                                        <strong>{edge.target}</strong>
                                        <small>({edge.target_type})</small>
                                    </span>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        </section>
    </div>
)}

