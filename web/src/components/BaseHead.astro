---
import Default from '@astrojs/starlight/components/Head.astro';

const { head } = Astro.locals.starlightRoute;

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const ogImagePath = `${base}/og-default.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).toString();
const ogImageAlt = 'Atruss Code Atlas — Codebase Architecture & Dependency Intelligence';

const hasOgImage = head.some(
	({ tag, attrs }) => tag === 'meta' && attrs?.property === 'og:image'
);
const hasTwitterImage = head.some(
	({ tag, attrs }) =>
		tag === 'meta' && (attrs?.name === 'twitter:image' || attrs?.property === 'twitter:image')
);
---

<Default />

{
	!hasOgImage && (
		<>
			<meta property="og:image" content={ogImageUrl} />
			<meta property="og:image:type" content="image/png" />
			<meta property="og:image:width" content="1024" />
			<meta property="og:image:height" content="571" />
			<meta property="og:image:alt" content={ogImageAlt} />
		</>
	)
}
{
	!hasTwitterImage && (
		<>
			<meta name="twitter:image" content={ogImageUrl} />
			<meta name="twitter:image:alt" content={ogImageAlt} />
		</>
	)
}
