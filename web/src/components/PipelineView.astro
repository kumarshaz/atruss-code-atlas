        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .m3-pipeline-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .m3-pipeline-chips .material-symbols-outlined {
        font-size: 16px;
    }

    .m3-findings-card,
    .m3-diagram-card {
        padding: 1.25rem;
    }

    .m3-section-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--md-sys-color-on-surface);
    }

    .m3-section-header .material-symbols-outlined {
        color: var(--md-sys-color-primary);
    }

