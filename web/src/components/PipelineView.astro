        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        margin-top: 1rem;
    }

    .m3-diagram-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.875rem;
    }

    .m3-tree-nav {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        margin-bottom: 0.75rem;
    }

    .m3-tree-breadcrumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
