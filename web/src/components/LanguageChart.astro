---
interface Repo {
    TechnologyStack?: string;
    PrimaryLanguage?: string;
    [key: string]: any;
}

interface Props {
    repos: Repo[];
}

const { repos = [] } = Astro.props;

const techFrequencies: Record<string, number> = {};

repos.forEach((repo) => {
    if (repo.TechnologyStack) {
        const techs = repo.TechnologyStack.split(',')
            .map((t) => t.trim())
            .filter(Boolean);
        techs.forEach((tech) => {
            techFrequencies[tech] = (techFrequencies[tech] || 0) + 1;
        });
    } else if (repo.PrimaryLanguage && repo.PrimaryLanguage !== 'Unknown') {
        techFrequencies[repo.PrimaryLanguage] =
            (techFrequencies[repo.PrimaryLanguage] || 0) + 1;
    }
});

const sortedTechs = Object.entries(techFrequencies)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 8);

const maxCount = sortedTechs.length > 0 ? sortedTechs[0][1] : 1;

const tonalBarTokens = [
    'var(--md-sys-color-primary)',
    'var(--md-sys-color-secondary)',
    'var(--md-sys-color-tertiary)',
    'var(--md-sys-color-success)',
    'var(--md-sys-color-warning)',
];
---

<section class="m3-card-elevated m3-chart-card">
    <header class="m3-card-header">
        <div class="m3-card-title-wrap">
            <span class="material-symbols-outlined m3-title-icon" aria-hidden="true">bar_chart</span>
            <h3>Ecosystem &amp; Technology Stack</h3>
        </div>
        <span class="m3-chip">{repos.length} scanned</span>
    </header>

    {sortedTechs.length === 0 ? (
        <p class="m3-empty-note">No technology signals extracted yet.</p>
    ) : (
        <div
            class="m3-bar-chart"
            role="img"
            aria-label="Horizontal distribution of detected ecosystems and platform tools"
        >
            {sortedTechs.map(([tech, count], idx) => {
                const widthPct = Math.max(8, Math.round((count / maxCount) * 100));
                const barToken = tonalBarTokens[idx % tonalBarTokens.length];

                return (
                    <div class="m3-bar-row">
                        <span class="m3-bar-label" title={tech}>
                            {tech}
                        </span>
                        <div class="m3-bar-track">
                            <div
                                class="m3-bar-fill"
                                style={`width: ${widthPct}%; background-color: ${barToken};`}
                            />
                        </div>
                        <span class="m3-bar-count">{count}</span>
                    </div>
                );
            })}
        </div>
    )}
</section>

<style>
    .m3-chart-card {
        padding: 1.5rem;
    }

    .m3-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .m3-card-title-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .m3-card-title-wrap h3 {
        margin: 0 !important;
        font-size: 1.125rem !important;
        font-weight: 600;
        color: var(--md-sys-color-on-surface);
    }

    .m3-title-icon {
        color: var(--md-sys-color-primary);
    }

    .m3-empty-note {
        color: var(--md-sys-color-on-surface-variant);
        margin: 0;
    }

    .m3-bar-chart {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
    }

    .m3-bar-row {
        display: grid;
        grid-template-columns: minmax(110px, 140px) 1fr 2.25rem;
        align-items: center;
        gap: 0.75rem;
    }

    .m3-bar-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .m3-bar-track {
        height: 0.625rem;
        background-color: var(--md-sys-color-surface-container-highest);
        border-radius: var(--md-sys-shape-corner-full);
        overflow: hidden;
    }

    .m3-bar-fill {
        height: 100%;
        border-radius: var(--md-sys-shape-corner-full);
        transition: width 350ms cubic-bezier(0.2, 0, 0, 1);
    }

    .m3-bar-count {
        font-family: var(--md-ref-typeface-mono);
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--md-sys-color-on-surface-variant);
        text-align: right;
    }
</style>
